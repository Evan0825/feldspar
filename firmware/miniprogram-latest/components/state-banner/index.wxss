.state-banner { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 24rpx; border: 1rpx solid var(--border, #eae2d5); border-radius: 24rpx; background: var(--amber-soft, #fbe9b6); color: var(--amber-deep, #654617); }
.state-banner.danger { background: var(--danger-soft, #f9eae4); color: var(--danger, #a13f31); }
.state-banner.info { background: var(--track, #f2ede5); color: var(--ink, #28231d); }
.state-icon { width: 42rpx; height: 42rpx; border-radius: 50%; background: rgba(255,255,255,.5); text-align: center; font-size: 27rpx; font-weight: 700; line-height: 42rpx; }
.state-content { flex: 1; }
.state-title, .state-detail { display: block; }
.state-title { font-size: 25rpx; font-weight: 700; }
.state-detail { margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; opacity: .9; }
.state-retry { display: inline-flex; align-items: center; justify-content: center; min-width: 120rpx; min-height: 84rpx; margin: 16rpx 0 0; padding: 0 24rpx; border: 1rpx solid currentColor; border-radius: 999rpx; background: transparent; color: inherit; font-size: 22rpx; line-height: 1.35; }
.state-retry::after { border: 0; }
