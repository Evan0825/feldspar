.state-banner { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; padding: 24rpx; border: 1rpx solid rgba(137,111,82,.12); border-radius: 24rpx; background: #f5e6ce; color: #59401f; }
.state-banner.danger { background: #f2dfd8; color: #813f2c; }
.state-banner.info { background: #eee7dd; color: #514a43; }
.state-icon { width: 42rpx; height: 42rpx; border-radius: 50%; background: rgba(255,255,255,.5); text-align: center; font-size: 27rpx; font-weight: 700; line-height: 42rpx; }
.state-content { flex: 1; }
.state-title, .state-detail { display: block; }
.state-title { font-size: 25rpx; font-weight: 700; }
.state-detail { margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; opacity: .9; }
.state-retry { display: inline-flex; align-items: center; justify-content: center; min-width: 120rpx; height: 60rpx; margin: 16rpx 0 0; padding: 0 24rpx; border: 1rpx solid currentColor; border-radius: 999rpx; background: transparent; color: inherit; font-size: 22rpx; line-height: 58rpx; }
.state-retry::after { border: 0; }
