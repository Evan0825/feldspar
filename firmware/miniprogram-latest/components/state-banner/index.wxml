<view class="state-banner {{tone}}"><view class="state-icon">{{tone === 'danger' ? '!' : '·'}}</view><view class="state-content"><text class="state-title">{{title}}</text><text class="state-detail">{{detail}}</text><button hover-class="none" wx:if="{{action === 'retry' && retryable}}" class="state-retry" bindtap="retry">{{retryText}}</button><button hover-class="none" wx:elif="{{action === 'reauth'}}" class="state-retry" bindtap="act">重新登录</button><button hover-class="none" wx:elif="{{action === 'setup'}}" class="state-retry" bindtap="act">前往设备设置</button></view></view>
