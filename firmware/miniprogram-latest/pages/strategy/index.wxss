.strategy-page { padding-top: 28rpx; }
.strategy-surface { overflow: hidden; border: 1rpx solid var(--border); border-radius: var(--card-radius); background: var(--paper); }
.stage-list { padding: 48rpx 32rpx 8rpx; }
.stage-row { display: flex; position: relative; min-height: 104rpx; gap: 24rpx; }
.stage-row:last-child { min-height: 104rpx; }
.stage-marker { display: flex; position: relative; width: 34rpx; flex-shrink: 0; justify-content: center; }
.stage-dot { z-index: 1; width: 28rpx; height: 28rpx; margin-top: 4rpx; border: 3rpx solid #a29b91; border-radius: 50%; background: var(--paper); }
.stage-line { position: absolute; top: 38rpx; bottom: 8rpx; width: 2rpx; background: #d8cec1; }
.current .stage-dot { border-color: var(--amber-edge); background: var(--amber); box-shadow: inset 0 0 0 4rpx var(--paper); }
.current .stage-line, .complete .stage-line { background: var(--amber); }
.stage-copy { flex: 1; min-width: 0; }
.stage-copy text { display: block; }
.stage-title { color: var(--ink); font-size: 30rpx; font-weight: 600; }
.current .stage-title { color: var(--amber-deep); }
.stage-detail { margin-top: 12rpx; color: var(--muted); font-size: 28rpx; }
.stage-badge { align-self: flex-start; padding: 10rpx 14rpx; border-radius: 15rpx; background: var(--amber-soft); color: var(--amber-deep); font-size: 24rpx; white-space: nowrap; }
.detail-row { display: flex; align-items: center; gap: 20rpx; min-height: 126rpx; margin: 0 30rpx; border-top: 1rpx solid var(--border); font-size: 28rpx; }
.detail-row image { width: 38rpx; height: 38rpx; flex-shrink: 0; }
.detail-row > text:last-child { flex: 1; color: var(--muted); text-align: right; font-size: 30rpx; }
.transition-note { padding: 28rpx 30rpx; background: var(--amber-soft); color: var(--brown); font-size: 30rpx; line-height: 1.6; }
.parameters-toggle { display: flex; justify-content: space-between; align-items: center; min-height: 96rpx; padding: 0 4rpx; background: transparent; color: var(--muted); font-size: 30rpx; text-align: left; }
.parameters { padding: 0 12rpx 24rpx; }
.parameters > view { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid var(--border); font-size: 26rpx; }
.parameters .secondary-button { margin-top: 20rpx; }
.state-card { padding: 48rpx 24rpx; color: var(--muted); text-align: center; }

.current-stage { padding: 34rpx 30rpx 10rpx; }
.current-stage > view:first-child { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.current-title { font-size: 50rpx; font-weight: 650; }
.progress { height: 8rpx; margin-top: 16rpx; overflow: hidden; border-radius: 8rpx; background: var(--track); }
.progress > view { height: 100%; background: var(--amber); }
.stages-toggle { width: calc(100% - 60rpx); margin: 0 30rpx; font-size: 26rpx; }
.stage-detail { font-size: 24rpx; margin-top: 6rpx; }
.transition-note { font-size: 26rpx; background: transparent; }

.collection-card { margin: 14rpx 24rpx 0; padding: 25rpx 26rpx; border-radius: 24rpx; background: var(--amber-soft); border: 1rpx solid var(--amber-soft); }
.collection-title { font-size: 33rpx; font-weight: 680; }
.collection-data-link { flex-shrink: 0; min-height: 84rpx; display: flex; align-items: center; margin: 0; padding: 9rpx 0 9rpx 14rpx; color: var(--amber-deep); background: transparent; font-size: 25rpx; line-height: 1.5; }
.collection-caption { display: block; margin-top: 12rpx; color: var(--muted); font-size: 23rpx; }
.collection-numbers { display: flex; gap: 38rpx; margin-top: 12rpx; color: var(--muted); font-size: 25rpx; }
.collection-count { color: var(--ink); font-size: 56rpx; font-weight: 700; margin-right: 8rpx; font-variant-numeric: tabular-nums; }
.collection-card .progress { height: 11rpx; }
.plan-review-button { margin: 20rpx 0 0; }
