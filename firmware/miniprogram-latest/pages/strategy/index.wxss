.strategy-page { padding-top: 28rpx; }
.strategy-surface { overflow: hidden; border: 1rpx solid rgba(122,101,78,.13); border-radius: 28rpx; background: var(--paper); }
.stage-list { padding: 40rpx 32rpx 8rpx; }
.stage-row { display: flex; position: relative; min-height: 176rpx; gap: 24rpx; }
.stage-row:last-child { min-height: 150rpx; }
.stage-marker { display: flex; position: relative; width: 34rpx; flex-shrink: 0; justify-content: center; }
.stage-dot { z-index: 1; width: 28rpx; height: 28rpx; margin-top: 4rpx; border: 3rpx solid #a29b91; border-radius: 50%; background: var(--paper); }
.stage-line { position: absolute; top: 38rpx; bottom: 8rpx; width: 2rpx; background: #d8cec1; }
.current .stage-dot { border-color: var(--amber-action); background: var(--amber-action); box-shadow: inset 0 0 0 4rpx var(--paper); }
.current .stage-line, .complete .stage-line { background: var(--amber); }
.stage-copy { flex: 1; min-width: 0; }
.stage-copy text { display: block; }
.stage-title { color: var(--ink); font-size: 40rpx; font-weight: 600; }
.current .stage-title { color: var(--amber-action); }
.stage-detail { margin-top: 12rpx; color: var(--muted); font-size: 32rpx; }
.stage-badge { align-self: flex-start; padding: 10rpx 14rpx; border-radius: 15rpx; background: #faecd8; color: var(--amber-deep); font-size: 24rpx; white-space: nowrap; }
.detail-row { display: flex; align-items: center; gap: 20rpx; min-height: 112rpx; margin: 0 30rpx; border-top: 1rpx solid #e9dfd1; font-size: 32rpx; }
.detail-row image { width: 38rpx; height: 38rpx; flex-shrink: 0; }
.detail-row > text:last-child { flex: 1; color: var(--muted); text-align: right; font-size: 30rpx; }
.transition-note { padding: 28rpx 30rpx; background: #fbefdc; color: var(--brown); font-size: 30rpx; line-height: 1.6; }
.parameters-toggle { display: flex; justify-content: space-between; align-items: center; min-height: 96rpx; padding: 0 4rpx; background: transparent; color: var(--muted); font-size: 30rpx; text-align: left; }
.parameters { padding: 0 12rpx 24rpx; }
.parameters > view { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid #e9dfd1; font-size: 26rpx; }
.parameters .secondary-button { margin-top: 20rpx; }
.state-card { padding: 48rpx 24rpx; color: var(--muted); text-align: center; }
