.report-page { padding-top: 28rpx; }
.recent-dates { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6rpx; margin: 0 0 28rpx; }
.recent-date { display: flex; flex-direction: column; align-items: center; gap: 9rpx; width: 100%; min-height: 84rpx; margin: 0; padding: 0; background: transparent; color: var(--muted); font-size: 23rpx; line-height: 1.35; }
.recent-day { display: flex; align-items: center; justify-content: center; width: min(80rpx, 100%); aspect-ratio: 1; border-radius: 50%; background: var(--paper); color: var(--ink); font-size: 32rpx; font-variant-numeric: tabular-nums; }
.recent-date.selected { color: var(--ink); font-weight: 700; }
.recent-date.selected .recent-day { background: var(--amber); }
.report-header { align-items: baseline; margin: 0 6rpx 20rpx; color: var(--muted); font-size: 24rpx; }
.report-date { display: flex; flex-wrap: wrap; align-items: baseline; gap: 5rpx 18rpx; min-width: 0; }
.sleep-summary { margin-top: 0; padding: 32rpx; border: 0; border-radius: 50rpx; background: var(--amber-soft); }
.duration-label { color: var(--ink); font-size: 31rpx; font-weight: 650; }
.sleep-summary .metric-symbol { background: var(--paper); }
.sleep-summary .metric-symbol.response { background: var(--success-soft); }
.duration-value { display: flex; align-items: baseline; gap: 13rpx; margin-top: 24rpx; font-size: 32rpx; font-variant-numeric: tabular-nums; }
.duration-number { color: var(--ink); font-size: 124rpx; font-weight: 700; line-height: 1; }
.detail-button { margin-top: 26rpx; }
.report-actions { padding: 0 24rpx; }
.report-action { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; width: 100%; min-height: 110rpx; margin: 0; padding: 0 12rpx; border-radius: 0; background: transparent; color: var(--ink); font-size: 30rpx; line-height: 1.4; }
.report-action > view { display: flex; align-items: center; gap: 9rpx; color: var(--muted); font-size: 24rpx; }
.report-action image { width: 29rpx; height: 29rpx; }
.state-card { padding: 42rpx; border-radius: var(--card-radius); background: var(--paper); color: var(--muted); text-align: center; font-size: 27rpx; }
.source-selection { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; color: var(--muted); font-size: 24rpx; }
.source-selection .ai-home-link { flex: none; width: auto; min-height: 84rpx; display: flex; align-items: center; margin: 0; padding: 0; color: var(--amber-deep); background: transparent; font-size: 24rpx; }
.reminder-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; margin-top: 34rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(135,102,17,.24); }
.reminder-metric + .reminder-metric { padding-left: 22rpx; border-left: 1rpx solid rgba(135,102,17,.24); }
.reminder-label { color: var(--amber-deep); font-size: 25rpx; }
.reminder-value { display: inline-block; margin-top: 8rpx; font-size: 56rpx; font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; }
.reminder-unit { margin-left: 8rpx; color: var(--ink); font-size: 25rpx; }
.night-summary { display: block; margin-top: 19rpx; color: var(--amber-deep); font-size: 25rpx; line-height: 1.6; }

@media (max-width: 365px) {
  .recent-dates { gap: 0; margin-right: -10px; margin-left: -10px; }
}
