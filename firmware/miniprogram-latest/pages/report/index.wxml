<view class="page report-page">
  <view class="source-selection" wx:if="{{sourceLabel}}"><text>依据 {{sourceLabel}}</text><button hover-class="none" class="ai-home-link" bindtap="clearSourceSelection">查看最新记录</button></view>
  <view class="recent-dates" wx:elif="{{recentDays.length}}">
    <button wx:for="{{recentDays}}" wx:key="date" class="recent-date {{selectedDate === item.date ? 'selected' : ''}}" hover-class="none" data-date="{{item.date}}" bindtap="selectQuickDate" aria-label="{{item.label}}" aria-pressed="{{selectedDate === item.date}}">
      <text class="recent-weekday">{{item.weekday}}</text><text class="recent-day">{{item.day}}</text>
    </button>
  </view>
  <view class="row report-header" wx:if="{{(selectedMonth && !sourceLabel) || report.dataSource === 'simulated' || report.dataSource === 'mixed'}}">
    <view class="report-date"><text wx:if="{{!sourceLabel}}">{{selectedMonth}}</text><text wx:if="{{report.dataSource === 'simulated' || report.dataSource === 'mixed'}}">{{report.dataSource === 'mixed' ? '含示例数据' : '示例数据'}}</text></view>
    <text wx:if="{{observationOnly && phase === 'data'}}">仅观察</text>
  </view>
  <view class="state-card" wx:if="{{phase === 'loading'}}">正在读取睡眠记录</view>
  <block wx:elif="{{phase === 'data'}}">
    <view class="card sleep-summary">
      <view class="metric-heading duration-label"><view class="metric-symbol"><image src="/images/ui/monitoring.png" aria-hidden="true" /></view><text>有效监测</text></view>
      <view wx:if="{{durationHours !== null}}" class="duration-value"><text class="duration-number">{{durationHours}}</text><text>小时</text><text class="duration-number">{{durationMinutes}}</text><text>分</text></view>
      <text wx:else class="duration-value">未核验</text>
      <view class="reminder-metrics">
        <view class="reminder-metric"><view class="metric-heading reminder-label"><view class="metric-symbol"><image src="/images/ui/vibration.png" aria-hidden="true" /></view><text>提醒次数</text></view><view><text class="reminder-value">{{reminderCount === null ? '—' : reminderCount}}</text><text class="reminder-unit" wx:if="{{reminderCount !== null}}">次</text></view></view>
        <view class="reminder-metric"><view class="metric-heading reminder-label"><view class="metric-symbol response"><image src="/images/ai-ui/check.png" aria-hidden="true" /></view><text>后续响应</text></view><view><text class="reminder-value">{{responseCount === null ? '—' : responseCount}}</text><text class="reminder-unit" wx:if="{{responseCount !== null}}">次</text></view></view>
      </view>
      <text wx:if="{{nightSummary}}" class="night-summary">{{nightSummary}}</text>
      <button hover-class="none" class="primary-button detail-button" bindtap="openData">查看数据</button>
    </view>
    <view class="card report-actions" wx:if="{{!sourceLabel}}">
      <button hover-class="none" class="report-action feedback-link" bindtap="openFeedback">
        <text>晨间反馈</text><view><text>{{feedback ? '已填写' : '待填写'}}</text><image src="/images/ai-ui/chevron-right.png" /></view>
      </button>
    </view>
  </block>
  <view wx:elif="{{phase === 'empty'}}" class="empty-state">该日期暂无完整记录</view>
  <view wx:elif="{{phase === 'source-unavailable'}}" class="empty-state">该日期暂无完整记录</view>
  <state-banner wx:elif="{{phase === 'error'}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="{{error.retryable}}" action="{{error.action}}" bindretry="retry" bindaction="handleServiceAction" />
  <button wx:if="{{phase === 'empty' || phase === 'period'}}" hover-class="none" class="primary-button detail-button" bindtap="openData">查看数据</button>
</view>
