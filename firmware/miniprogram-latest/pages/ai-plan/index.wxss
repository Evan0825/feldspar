.plan-page { padding-top: 34rpx; }
.plan-hero { margin-top: 12rpx; }
.plan-page .page-title { font-size: 52rpx; line-height: 1.35; }
.plan-lead { display: block; margin-top: 16rpx; color: #675d53; font-size: 28rpx; line-height: 1.6; }
.state-card { margin-top: 30rpx; padding: 48rpx; border-radius: 30rpx; background: #fffaf2; color: #675d53; text-align: center; }
.rationale-card { margin-top: 30rpx; padding: 24rpx 26rpx; border-radius: 24rpx; background: #f2dfc2; }
.rationale-card text { display: block; }
.rationale-card text:first-child { color: #a76522; font-size: 25rpx; }
.rationale-card text:last-child { margin-top: 10rpx; color: #4c382c; font-size: 28rpx; line-height: 1.65; }
.compare-card { margin-top: 18rpx; overflow: hidden; border: 1rpx solid rgba(137,111,82,.10); border-radius: 28rpx; background: #fffaf2; }
.compare-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; padding: 0 26rpx; }
.compare-row + .compare-row { border-top: 1rpx solid rgba(94,75,57,.10); }
.compare-row > text { color: #675d53; font-size: 28rpx; }
.compare-row view { display: flex; align-items: center; gap: 12rpx; font-size: 32rpx; font-weight: 650; }
.compare-row view text:nth-child(2) { color: #a76522; font-weight: 400; }
.compare-row view text:last-child { color: #a76522; }
.plan-boundary { margin-top: 20rpx; color: #675d53; font-size: 24rpx; line-height: 1.65; }
.command-card { margin-top: 24rpx; padding: 28rpx; border-radius: 28rpx; background: #fffaf2; }
.command-card text { display: block; }
.command-label { color: #a76522; font-size: 25rpx; }
.command-title { margin-top: 10rpx; font-size: 34rpx; font-weight: 650; }
.command-copy { margin-top: 9rpx; color: #675d53; font-size: 27rpx; line-height: 1.55; }
.reconcile { margin-top: 20rpx; }
.apply-button { margin-top: 28rpx; }
.manual-button { margin-top: 14rpx; }
