.trends-page { padding-top: 30rpx; }
.chart-card { margin-top: 28rpx; padding: 28rpx 20rpx 22rpx; border-radius: 32rpx; background: var(--paper); }
.chart-title { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; }
.chart-title .metric-heading text { font-weight: 700; }
.chart { height: 210rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 9rpx; margin-top: 20rpx; padding: 0 6rpx; border-bottom: 1rpx solid var(--border); }
.bar-column { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar { position: relative; width: 52rpx; border-radius: 999rpx 999rpx 6rpx 6rpx; background: var(--amber); }
.bar > text { position: absolute; top: -30rpx; left: 0; width: 100%; color: var(--muted); text-align: center; font-size: 17rpx; }
.bar-column > text { margin-top: 10rpx; color: var(--muted); font-size: 16rpx; }
.legend { display: flex; justify-content: flex-end; gap: 18rpx; margin-top: 18rpx; color: var(--muted); font-size: 17rpx; }
.legend > view { display: flex; align-items: center; gap: 6rpx; }
.legend-mark { width: 14rpx; height: 14rpx; border-radius: 4rpx; background: #ddd3c6; }
.legend-mark.amber { background: var(--amber); }
.trend-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 16rpx; }
.trend-card { padding: 25rpx; border-radius: 25rpx; background: var(--paper); }
.trend-card text { display: block; }
.trend-card > text:last-child:not(.trend-value) { color: var(--muted); font-size: 22rpx; }
.trend-value { margin-top: 10rpx; font-size: 38rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.question { padding: 23rpx 0; border-bottom: 1rpx solid #eee4d7; }
.question:first-child { padding-top: 0; }
.question > text { font-weight: 650; }
.choice-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }
.choice { min-height: 84rpx; display: flex; align-items: center; justify-content: center; padding: 15rpx; border: 1rpx solid var(--border); border-radius: 999rpx; color: var(--muted); text-align: center; font-size: 26rpx; }
.choice.active { border-color: var(--amber-edge); background: var(--amber-soft); color: var(--amber-deep); }
.energy-row { display: grid; grid-template-columns: repeat(5,1fr); gap: 9rpx; margin-top: 18rpx; }
.energy { height: 84rpx; border-radius: 999rpx; background: var(--track); color: var(--muted); text-align: center; line-height: 84rpx; }
.energy.active { background: var(--amber); color: var(--on-amber); }
.choice.disabled,.energy.disabled { opacity: .5; pointer-events: none; }
.energy-label { display: flex; justify-content: space-between; margin-top: 8rpx; color: var(--muted); font-size: 16rpx; }
.feedback-button { margin-top: 24rpx; }
.guidance-card,.state-card { margin-top: 24rpx; padding: 28rpx; border-radius: 28rpx; background: var(--paper); }
.guidance-card text,.state-card text { display: block; }
.guidance-card text:first-child,.state-title { font-size: 26rpx; font-weight: 700; }
.guidance-card text:nth-child(2),.state-copy { margin-top: 8rpx; color: var(--amber-deep); font-size: 22rpx; }
.guidance-card text:last-child { margin-top: 12rpx; color: var(--muted); font-size: 21rpx; line-height: 1.55; }
.guidance-card.stable { background: var(--success-soft); }
.guidance-card.consult { background: var(--danger-soft); }
.state-card { text-align: center; }
.state-copy { color: var(--muted); line-height: 1.55; }
.error-card .primary-button { margin-top: 22rpx; }
