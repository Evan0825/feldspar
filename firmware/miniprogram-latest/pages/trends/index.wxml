<view class="page trends-page">

  <view class="state-card" wx:if="{{loading}}"><text class="state-title">{{feedbackOnly ? '正在读取晨间反馈' : '正在读取趋势'}}</text></view>
  <block wx:if="{{!loading && phase === 'data'}}">
    <state-banner wx:if="{{dataSource === 'simulated' || dataSource === 'mixed'}}" tone="info" title="{{dataSource === 'mixed' ? '含模拟测试数据' : '示例数据'}}" />
    <block wx:if="{{!feedbackOnly}}">
    <state-banner wx:if="{{insufficientData}}" tone="info" title="有效夜晚少于 3 晚" detail="当前趋势仅供参考，继续记录至少 3 个有效夜晚后再观察连续变化。" />
    <view class="guidance-card {{guidance.tone}}" wx:if="{{guidance}}"><text>{{guidance.label}}</text><text>{{guidance.action}}</text></view>
    <view class="chart-card">
      <view class="chart-title"><view class="metric-heading"><view class="metric-symbol neutral"><image src="/images/ui/sound.png" aria-hidden="true" /></view><text>鼾声事件</text></view></view>
      <view class="chart"><view class="bar-column" wx:for="{{nights}}" wx:key="date"><view class="bar" style="height: {{item.barHeight}}rpx"><text>{{item.snoreCount === null ? '—' : item.snoreCount}}</text></view><text>{{item.date}}</text></view></view>
      <view class="legend"><view><view class="legend-mark amber"></view><text>有效记录</text></view><view><text>—</text><text>暂无数据</text></view></view>
    </view>
    <view class="trend-grid"><view class="trend-card"><view class="metric-heading"><view class="metric-symbol response"><image src="/images/ai-ui/check.png" aria-hidden="true" /></view><text>提醒响应率</text></view><text class="trend-value">{{lastSuccessRate == null ? '—' : lastSuccessRate + '%'}}</text><text>最近一晚</text></view><view class="trend-card"><view class="metric-heading"><view class="metric-symbol"><image src="/images/ai-ui/calendar.png" aria-hidden="true" /></view><text>有效夜晚</text></view><text class="trend-value">{{validCount}} / 7</text></view></view>

    </block>
    <view class="section-title" id="morning-feedback">{{feedbackOnly ? currentNightDate : '晨间反馈' + (currentNightDate ? ' · ' + currentNightDate : '')}}</view>
    <view class="feedback-card card">
      <view class="question"><text>这晚是否被弄醒</text><view class="choice-row"><view class="choice {{feedback.awakened === false ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" role="radio" aria-checked="{{feedback.awakened === false}}" aria-disabled="{{submitting}}" data-key="awakened" data-value="false" bindtap="chooseBoolean">没有</view><view class="choice {{feedback.awakened === true ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" role="radio" aria-checked="{{feedback.awakened === true}}" aria-disabled="{{submitting}}" data-key="awakened" data-value="true" bindtap="chooseBoolean">有</view></view></view>
      <view class="question"><text>伴侣是否受影响</text><view class="choice-row"><view class="choice {{feedback.partnerAffected === false ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" role="radio" aria-checked="{{feedback.partnerAffected === false}}" aria-disabled="{{submitting}}" data-key="partnerAffected" data-value="false" bindtap="chooseBoolean">没有</view><view class="choice {{feedback.partnerAffected === true ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" role="radio" aria-checked="{{feedback.partnerAffected === true}}" aria-disabled="{{submitting}}" data-key="partnerAffected" data-value="true" bindtap="chooseBoolean">有</view></view></view>
      <view class="question"><text>次日精神状态</text><view class="energy-row"><view wx:for="{{energyOptions}}" wx:key="*this" class="energy {{feedback.nextDayEnergy === item ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" role="radio" aria-label="精神状态 {{item}} 分" aria-checked="{{feedback.nextDayEnergy === item}}" aria-disabled="{{submitting}}" data-value="{{item}}" bindtap="setEnergy">{{item}}</view></view><view class="energy-label"><text>很疲惫</text><text>状态很好</text></view></view>
      <button hover-class="none" class="primary-button feedback-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitFeedback">{{submitted ? '更新反馈' : '提交反馈'}}</button>
    </view>
  </block>
  <view class="empty-state" wx:if="{{!loading && phase === 'empty'}}">{{feedbackOnly ? '暂无可填写反馈的睡眠记录。' : '暂无有效夜间记录。'}}</view>
  <view class="state-card error-card" wx:if="{{!loading && phase === 'unavailable'}}"><text class="state-title">趋势关注类别暂不可用</text><text class="state-copy">{{errorMessage}}</text><button hover-class="none" class="primary-button" bindtap="retry">重新同步</button></view>
  <state-banner wx:if="{{!loading && phase === 'error'}}" tone="danger" title="{{error.title}}" detail="{{errorMessage}}" retryable="{{error.retryable}}" action="{{error.action}}" retryText="重新同步" bindretry="retry" bindaction="handleServiceAction" />

</view>
