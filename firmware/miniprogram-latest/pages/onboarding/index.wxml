<view class="page onboarding {{editingProfile ? 'preferences-page' : ''}}">
  <view class="brand" wx:if="{{!editingProfile}}">月石</view>
  <state-banner wx:if="{{error}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="{{error.retryable}}" action="{{error.action}}" bindaction="handleServiceAction" bindretry="handleServiceAction" />

  <block wx:if="{{phase === 'login'}}">
    <view class="moon-mark"><view class="moon-glow"></view></view>
    <view class="page-title">让夜晚安静一点</view>
    <view class="page-lead">微信身份用于保存你的连续趋势、设备绑定和家庭睡眠设置。</view>
    <button hover-class="none" class="primary-button login-button" loading="{{loading}}" disabled="{{submitting}}" bindtap="login">微信登录并继续</button>
    <view class="safe-note">月石是家庭趋势观察设备，不替代医疗检查。</view>
  </block>

  <block wx:elif="{{phase === 'profile'}}">
    <view class="page-title" wx:if="{{!editingProfile}}">先认识一下你</view>
    <view class="preferences-loading" wx:if="{{editingProfile && loading}}">正在读取偏好</view>
    <block wx:if="{{!editingProfile || preferencesLoaded}}">
      <view class="card form-card">
        <view class="field-label">称呼</view>
        <input class="text-input" aria-label="称呼" value="{{nickname}}" maxlength="16" disabled="{{submitting}}" bindinput="setNickname" />
        <view class="field-label second">同睡情况</view>
        <view class="mode-grid">
          <view role="radio" aria-checked="{{sleepMode === 'solo'}}" class="mode-option {{sleepMode === 'solo' ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" data-mode="solo" bindtap="setSleepMode"><image src="/images/ui/person.png" mode="aspectFit" /><text class="mode-title">独睡</text><view class="radio-mark" /></view>
          <view role="radio" aria-checked="{{sleepMode === 'shared'}}" class="mode-option {{sleepMode === 'shared' ? 'active' : ''}} {{submitting ? 'disabled' : ''}}" data-mode="shared" bindtap="setSleepMode"><image src="/images/ui/people.png" mode="aspectFit" /><text class="mode-title">共享睡眠</text><view class="radio-mark" /></view>
        </view>
      </view>
      <view class="default-reminder"><text>默认提醒方式</text><text>振动</text></view>
      <view class="preferences-heading"><text>提醒偏好</text><button hover-class="none" class="help-button" aria-label="了解提醒偏好的作用" bindtap="explainReminderPreferences"><image src="/images/ui/info.png" mode="aspectFit" /></button></view>
      <view class="reminder-options">
        <view class="reminder-option {{submitting ? 'disabled' : ''}}" role="checkbox" aria-checked="{{excludeSoundReminder}}" data-key="excludeSoundReminder" bindtap="toggleReminderExclusion"><view class="check-box {{excludeSoundReminder ? 'checked' : ''}}"><image wx:if="{{excludeSoundReminder}}" src="/images/ui/check.png" /></view><text>不使用声音提醒</text></view>
        <view class="reminder-option {{submitting ? 'disabled' : ''}}" role="checkbox" aria-checked="{{excludeLightReminder}}" data-key="excludeLightReminder" bindtap="toggleReminderExclusion"><view class="check-box {{excludeLightReminder ? 'checked' : ''}}"><image wx:if="{{excludeLightReminder}}" src="/images/ui/check.png" /></view><text>不使用灯光提醒</text></view>
      </view>
      <button hover-class="none" class="primary-button preferences-save" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveProfile">{{editingProfile ? '保存偏好' : '继续'}}</button>
    </block>
  </block>

  <block wx:else>
    <view class="page-title">隐私与使用边界</view>
    <view class="page-lead">请确认以下三项，再开始绑定设备。</view>
    <view class="card privacy-card">
      <view class="privacy-row"><view><text>结构化事件上云</text><text>保存事件、摘要和趋势</text></view><switch color="#D28B2D" checked="{{privacy.structured}}" disabled="{{submitting}}" data-key="structured" bindchange="togglePrivacy" /></view>
      <view class="privacy-row"><view><text>整夜原始录音默认不上云</text><text>小程序不提供原始音频回放</text></view><switch color="#D28B2D" checked="{{privacy.rawAudio}}" disabled="{{submitting}}" data-key="rawAudio" bindchange="togglePrivacy" /></view>
      <view class="privacy-row"><view><text>非医疗诊断</text><text>用于趋势观察与体位提醒</text></view><switch color="#D28B2D" checked="{{privacy.nonMedical}}" disabled="{{submitting}}" data-key="nonMedical" bindchange="togglePrivacy" /></view>
    </view>
    <button hover-class="none" class="primary-button" loading="{{submitting}}" disabled="{{submitting || !privacy.structured || !privacy.rawAudio || !privacy.nonMedical}}" bindtap="acceptPrivacy">同意并添加设备</button>
  </block>
</view>
