.light-page { padding-top: 24rpx; }
.lamp-stage { position: relative; overflow: hidden; border-radius: var(--card-radius); background: var(--track); }
.lamp-stage.on { background: var(--paper); }
.lamp-stage .product-visual { position: relative; z-index: 1; }
.lamp-glow { position: absolute; left: 3%; bottom: 12%; width: 55%; height: 120rpx; background: radial-gradient(ellipse at center, var(--amber), transparent 73%); }
.lamp-stage.white .lamp-glow { background: radial-gradient(ellipse at center, #fff, transparent 73%); }
.light-toggle { width: 100%; margin: 22rpx 0 0; }
.mode-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.mode-card { display: flex; align-items: center; gap: 12rpx; min-height: 94rpx; padding: 18rpx; border: 1rpx solid var(--border); border-radius: 28rpx; background: var(--paper); }
.mode-card.active { border-color: var(--amber-edge); background: var(--amber-soft); color: var(--amber-deep); }
.mode-card image { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.mode-card text { font-size: 27rpx; font-weight: 600; }
.mode-card.disabled { opacity: .55; pointer-events: none; }
.night-slider { margin-top: 24rpx; padding: 25rpx 28rpx 14rpx; border: 1rpx solid var(--border); border-radius: var(--card-radius); background: var(--paper); }
.slider-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 30rpx; font-weight: 650; }
.slider-value { color: var(--amber-deep); font-size: 38rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.large-slider { display: flex; min-height: 88rpx; align-items: center; }
.large-slider slider { width: 100%; margin: 0; }
.state-card { margin-top: 24rpx; padding: 28rpx; border-radius: var(--card-radius); background: var(--paper); color: var(--muted); text-align: center; }
.state-title { font-weight: 650; }
