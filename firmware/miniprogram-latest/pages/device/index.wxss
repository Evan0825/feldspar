.device-page { padding-top: 20rpx; }
.state-card { margin-top: 24rpx; padding: 28rpx; border-radius: 28rpx; background: var(--paper); text-align: center; }
.state-card text { display: block; }
.state-title { font-weight: 700; }
.state-copy { margin-top: 8rpx; color: var(--muted); font-size: 21rpx; }
.device-hero { display: flex; align-items: center; gap: 28rpx; min-height: 164rpx; margin-top: 12rpx; padding: 24rpx; }
.device-image { width: 190rpx; height: 148rpx; flex: 0 0 auto; border-radius: 22rpx; }
.device-hero text { display: block; }
.device-name { font-size: 29rpx; font-weight: 700; }
.device-name + text { margin-top: 8rpx; color: var(--muted); font-size: 20rpx; }
.online-copy { display: inline-flex; margin-top: 12rpx; padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(83,108,45,.10); color: var(--success); font-size: 22rpx; font-weight: 600; }
.reconnect-card { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 18rpx; padding: 24rpx 26rpx; }
.reconnect-card > view { flex: 1; }
.reconnect-card text { display: block; }
.reconnect-title { color: var(--ink); font-size: 25rpx; font-weight: 650; }
.reconnect-copy { margin-top: 7rpx; color: var(--muted); font-size: 20rpx; line-height: 1.45; }
.reconnect-card button { margin: 0; color: var(--amber-deep); background: var(--amber-soft); font-size: 21rpx; }
.reconnect-error { display: block; margin: -6rpx 0 18rpx; color: var(--danger); font-size: 21rpx; }
.detail-list { padding-top: 6rpx; padding-bottom: 6rpx; }
.detail-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eee4d7; }
.detail-row:last-child { border-bottom: 0; }
.detail-row view { flex: 1; }
.detail-row view text { display: block; }
.detail-row view text:first-child { font-weight: 650; }
.detail-row view text:nth-child(2) { margin-top: 7rpx; color: var(--muted); font-size: 20rpx; }
.value { color: var(--muted); font-size: 21rpx; }
.value.ok { color: var(--success); font-weight: 600; }
.value.warn { color: var(--amber-deep); }

.safety-card { padding: 22rpx 26rpx; }
.safety-card > .reconnect-copy:first-child { margin-top: 0; font-size: 23rpx; }
.stop-button { margin-top: 16rpx; background: var(--danger-soft); color: var(--danger); border-radius: 18rpx; font-size: 29rpx; font-weight: 650; }
.resume-button { margin-top: 12rpx; }
.safety-help { display: inline-block; margin: 9rpx 0 0; padding: 0; background: transparent; color: var(--amber-deep); font-size: 22rpx; line-height: 2; }
.safety-card .reconnect-error { margin: 7rpx 0 0; }
