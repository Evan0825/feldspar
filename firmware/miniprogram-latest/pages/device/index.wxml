<view class="page device-page">

  <view class="state-card" wx:if="{{loading}}"><text class="state-title">正在读取设备状态</text></view>
  <state-banner wx:elif="{{error}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="{{error.retryable}}" action="{{error.action}}" bindretry="retry" bindaction="handleServiceAction" />
  <view class="empty-state" wx:elif="{{phase === 'empty'}}">暂无设备状态。请确认已绑定月石床头主机后重试。</view>
  <block wx:else>
  <state-banner wx:if="{{status.dataSource === 'simulated'}}" tone="info" title="当前包含模拟测试数据" detail="模拟记录用于页面联调，不代表真实睡眠情况。" />

  <view class="card device-hero"><image class="device-image" src="/images/host-detail.png" mode="aspectFit" /><view><text class="device-name">月石床头主机</text><text>{{status.cloudOnline ? '云端在线' : status.ble.connected ? '蓝牙已连接' : status.host.online ? '在线' : '离线'}}</text></view></view>

  <view class="section-title" wx:if="{{status.bound}}">安全控制</view>
  <view class="card safety-card" wx:if="{{status.bound}}">
    <view class="reconnect-copy">{{status.safety.available ? status.safety.stopLatched ? '输出已全停' : '手动控制可用' : '安全状态待确认'}}</view>
    <button hover-class="none" class="stop-button" loading="{{safetyBusy}}" disabled="{{safetyBusy}}" bindtap="safetyAction">停止全部输出</button>
    <button hover-class="none" class="safety-help" bindtap="showSafetyHelp">实体按键说明</button>
    <text class="reconnect-error" wx:if="{{safetyError}}">{{safetyError}}</text>
  </view>

  <view class="section-title">连接状态</view>
  <view class="card reconnect-card">
    <view><text class="reconnect-title">手机蓝牙</text><text class="reconnect-copy">{{status.ble.connected ? '已连接' : '未连接'}}</text></view>
    <button hover-class="none" size="mini" loading="{{reconnecting}}" disabled="{{reconnecting}}" bindtap="reconnectBluetooth">{{status.ble.connected ? '重新连接' : '连接'}}</button>
  </view>
  <text class="reconnect-error" wx:if="{{reconnectError}}">{{reconnectError}}</text>
  <view class="card reconnect-card">
    <view>
      <text class="reconnect-title">设备 Wi-Fi</text>
      <text class="reconnect-copy" wx:if="{{wifiStatus.connected}}">已连接{{wifiStatus.ssid ? ' · ' + wifiStatus.ssid : ''}}{{wifiStatus.ip ? ' · ' + wifiStatus.ip : ''}}</text>
      <text class="reconnect-copy" wx:elif="{{wifiStatus.configured}}">已配置，未连接{{wifiStatus.ssid ? ' · ' + wifiStatus.ssid : ''}}</text>
      <text class="reconnect-copy" wx:elif="{{wifiStatus && wifiStatus.configured === false}}">未配网</text>
      <text class="reconnect-copy" wx:elif="{{!status.cloudOnline}}">{{status.ble.connected ? 'Wi-Fi 状态待确认' : '连接蓝牙后可读取 Wi-Fi 状态'}}</text>
      <text class="reconnect-copy">{{status.cloudOnline ? '云端在线' : status.cloudUnavailable ? '暂时无法连接云端' : '云端在线待确认'}}</text>
    </view>
    <button hover-class="none" size="mini" bindtap="openWifiSetup">配网</button>
  </view>
  <view class="card detail-list">
    <view class="detail-row"><view><text>枕下定向振动片</text></view><text class="value {{status.pad.connected ? 'ok' : 'warn'}}">{{status.pad.connected ? '有线已连接' : status.pad.status === 'unknown' ? '待核验' : '未就绪'}}</text></view>
  </view>

  <view class="section-title">感知状态</view>
  <view class="card detail-list">
    <view class="detail-row"><view><text>麦克风</text></view><text class="value {{status.microphones.status === 'ready' ? 'ok' : 'warn'}}">{{status.microphones.status === 'ready' ? '已就绪' : status.microphones.status === 'unknown' ? '待核验' : '需检查'}}</text></view>
    <view class="detail-row"><view><text>24G 毫米波雷达（可选）</text><text>用于在床与体动观测</text></view><text class="value {{status.radar.status === 'ready' ? 'ok' : 'warn'}}">{{status.radar.status === 'ready' ? '已就绪' : status.radar.status === 'not_installed' ? '未安装' : '待核验'}}</text></view>
  </view>
  <button wx:if="{{status.bleVibrationTestAvailable || status.cloudVibrationTestAvailable}}" hover-class="none" class="secondary-button" loading="{{vibrationTesting}}" disabled="{{vibrationTesting}}" bindtap="startVibrationTest">试振 2 秒</button>
  <text wx:if="{{vibrationMessage}}" class="state-copy">{{vibrationMessage}}</text>
  <button wx:if="{{status.bound}}" hover-class="none" class="secondary-button" bindtap="openCalibration">设备自检</button>

  <view class="section-title">版本与同步</view>
  <view class="card detail-list">
    <view class="detail-row" role="button" data-kind="firmware" bindtap="showUpdateInfo">
      <view><text>固件版本</text><text>{{localFirmwareVersion || status.host.firmwareVersion || '未核验'}}</text></view>
      <text class="value {{status.host.firmwareUpdateAvailable === true ? 'warn' : ''}}">{{status.host.firmwareUpdateAvailable === true ? '待更新 ›' : status.host.firmwareUpdateAvailable === false ? '暂无更新' : '更新状态未核验 ›'}}</text>
    </view>
    <view class="detail-row" role="button" data-kind="model" bindtap="showUpdateInfo">
      <view><text>本地模型</text><text>{{status.host.modelVersion || '未核验'}}</text></view>
      <text class="value {{status.host.modelUpdateAvailable === true ? 'warn' : ''}}">{{status.host.modelUpdateAvailable === true ? '待更新 ›' : status.host.modelUpdateAvailable === false ? '暂无更新' : '更新状态未核验 ›'}}</text>
    </view>
    <view class="detail-row"><view><text>上次同步</text></view><text class="value {{status.sync.status === 'success' ? 'ok' : ''}}">{{status.sync.lastSyncedAt || '未同步'}}</text></view>
    <view class="detail-row"><view><text>数据来源</text></view><text class="value {{status.dataSource === 'device' ? 'ok' : 'warn'}}">{{status.dataSource === 'device' ? '真实设备' : status.dataSource === 'simulated' ? '模拟测试' : '尚无数据'}}</text></view>
  </view>

  </block>
</view>
