<view class="page device-page">
  <view class="brand">月石</view><view class="page-title">月石设备</view>
  <view class="page-lead">查看实际连接、采集和安全控制状态。</view>
  <view class="state-card" wx:if="{{loading}}"><text class="state-title">正在读取设备状态</text><text class="state-copy">正在同步主机、振动片与本地检测信息。</text></view>
  <state-banner wx:elif="{{error}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="{{error.retryable}}" action="{{error.action}}" bindretry="retry" bindaction="handleServiceAction" />
  <view class="empty-state" wx:elif="{{phase === 'empty'}}">暂无设备状态。请确认已绑定月石床头主机后重试。</view>
  <block wx:else>
  <state-banner wx:if="{{status.dataSource === 'simulated'}}" tone="info" title="当前包含模拟测试数据" detail="模拟记录用于页面联调，不代表真实睡眠情况。" />

  <view class="card device-hero"><image class="device-image" src="/images/host-detail.png" mode="aspectFit" /><view><text class="device-name">月石床头主机</text><text>{{status.host.serialNumber}}</text><text class="online-copy">{{status.host.online ? '在线' : '离线'}}</text></view></view>

  <view class="section-title">连接状态</view>
  <view class="card reconnect-card">
    <view><text class="reconnect-title">手机蓝牙</text><text class="reconnect-copy">{{status.ble.connected ? '已连接，可进行本地即时控制' : '未连接，可重新连接附近月石'}}</text></view>
    <button hover-class="none" size="mini" loading="{{reconnecting}}" disabled="{{reconnecting}}" bindtap="reconnectBluetooth">{{status.ble.connected ? '重新连接' : '连接'}}</button>
  </view>
  <text class="reconnect-error" wx:if="{{reconnectError}}">{{reconnectError}}</text>
  <view class="card reconnect-card">
    <view><text class="reconnect-title">设备 Wi-Fi</text><text class="reconnect-copy">{{status.cloudOnline ? '设备已上报云端；守护状态仍需单独核验' : status.cloudUnavailable ? '暂时无法连接云端，本地蓝牙状态单独显示' : '尚未确认设备云端在线'}}</text></view>
    <button hover-class="none" size="mini" bindtap="openWifiSetup">配网</button>
  </view>
  <view class="card detail-list">
    <view class="detail-row"><view><text>枕下定向振动片</text><text>连接状态以实际检测为准</text></view><text class="value {{status.pad.connected ? 'ok' : 'warn'}}">{{status.pad.connected ? '有线已连接' : status.pad.status === 'unknown' ? '待核验' : '未就绪'}}</text></view>
  </view>

  <view class="section-title">感知状态</view>
  <view class="card detail-list">
    <view class="detail-row"><view><text>麦克风</text><text>采集质量与识别结果分别核验</text></view><text class="value {{status.microphones.status === 'ready' ? 'ok' : 'warn'}}">{{status.microphones.status === 'ready' ? '已就绪' : status.microphones.status === 'unknown' ? '待核验' : '需检查'}}</text></view>
    <view class="detail-row"><view><text>24G 毫米波雷达（可选）</text><text>在床与体动观测以实际能力为准</text></view><text class="value {{status.radar.status === 'ready' ? 'ok' : 'warn'}}">{{status.radar.status === 'ready' ? '已就绪' : status.radar.status === 'not_installed' ? '未安装' : '待核验'}}</text></view>
  </view>

  <view class="section-title" wx:if="{{status.bound}}">安全控制</view>
  <view class="card" wx:if="{{status.bound}}">
    <view class="reconnect-copy">{{status.safety.available ? status.safety.stopLatched ? '手动启动已暂停，恢复控制不会自动开启输出。' : '手动控制可用；自动提醒保持关闭。' : '当前固件未提供安全状态回读，请先核验设备版本。'}}</view>
    <view class="reconnect-copy" wx:if="{{status.safety.available}}">实体按键：短按切换灯光，长按 2 秒停止全部输出；停止锁定后需通过蓝牙恢复手动控制。回读表示驱动状态，不代表独立传感器验证。</view>
    <button hover-class="none" loading="{{safetyBusy}}" disabled="{{safetyBusy}}" data-kind="stop" bindtap="safetyAction">停止全部输出</button>
    <button wx:if="{{status.ble.connected}}" hover-class="none" disabled="{{safetyBusy || !status.safety.available || !status.safety.stopLatched}}" data-kind="resume" bindtap="safetyAction">恢复手动控制</button>
    <text class="reconnect-error" wx:if="{{safetyError}}">{{safetyError}}</text>
  </view>

  <view class="section-title">版本与同步</view>
  <view class="card detail-list">
    <view class="detail-row" data-kind="firmware" bindtap="showUpdateInfo"><view><text>固件版本</text><text>{{status.host.firmwareVersion}}</text></view><text class="value">{{status.host.firmwareUpdateAvailable ? '待更新 ›' : '更新状态未核验'}}</text></view>
    <view class="detail-row" data-kind="model" bindtap="showUpdateInfo"><view><text>检测算法版本</text><text>{{status.host.modelVersion}}</text></view><text class="value {{status.host.modelUpdateAvailable ? 'warn' : ''}}">{{status.host.modelUpdateAvailable ? '待更新 ›' : '更新状态未核验'}}</text></view>
    <view class="detail-row"><view><text>上次同步</text><text>结构化事件与夜间摘要</text></view><text class="value {{status.sync.status === 'success' ? 'ok' : 'warn'}}">{{status.sync.lastSyncedAt}}</text></view>
    <view class="detail-row"><view><text>数据来源</text><text>真实设备与模拟记录会明确区分</text></view><text class="value {{status.dataSource === 'device' ? 'ok' : 'warn'}}">{{status.dataSource === 'device' ? '真实设备' : status.dataSource === 'simulated' ? '模拟测试' : '尚无数据'}}</text></view>
  </view>

  <view class="safe-note">自动提醒需完成采集、识别与安全条件核验后启用。</view>
  </block>
</view>
