.setup-page { padding: 58rpx 40rpx 48rpx; }
.page-title { margin-top: 0; font-size: 56rpx; line-height: 1.24; }
.page-lead { margin-top: 16rpx; font-size: 25rpx; }
.product-hero { width: 100%; height: 330rpx; margin-top: 82rpx; border-radius: 28rpx; transform: scale(1.45); transform-origin: center; }
.device-row { display: flex; align-items: center; gap: 22rpx; min-height: 88rpx; }
.device-row .status-dot { flex: 0 0 auto; width: 18rpx; height: 18rpx; }
.device-main { display: flex; flex: 1; align-items: center; justify-content: space-between; gap: 20rpx; }
.device-name { color: #2f2923; font-size: 31rpx; font-weight: 500; }
.device-meta { color: #675d53; font-size: 24rpx; }
.bluetooth-button { width: 100%; margin-top: 28rpx; }
.identity-note { display: block; margin-top: 24rpx; color: #675d53; font-size: 22rpx; text-align: center; }

.network-stage .page-lead { margin-bottom: 16rpx; }
.ble-mini-card { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 0 26rpx; padding: 22rpx 24rpx; border: 1rpx solid rgba(83,108,45,.16); border-radius: 22rpx; background: rgba(255,250,242,.82); }
.ble-mini-card > view { display: flex; align-items: center; gap: 14rpx; color: #536c2d; font-size: 24rpx; font-weight: 600; }
.ble-mini-card .status-dot { width: 16rpx; height: 16rpx; }
.ble-mini-card button, .wifi-heading button { margin: 0; color: #a76522; background: transparent; font-size: 22rpx; }
.wifi-heading, .password-heading { display: flex; align-items: center; justify-content: space-between; }
.wifi-heading { margin-top: 12rpx; color: #2f2923; font-size: 27rpx; font-weight: 650; }
.wifi-source { display: block; margin-top: 6rpx; color: #675d53; font-size: 20rpx; }
.password-heading .field-label { margin-bottom: 12rpx; }
.password-heading > text:last-child { margin-top: 24rpx; color: #a76522; font-size: 22rpx; }
.wifi-list { max-height: 360rpx; margin-top: 14rpx; overflow-y: auto; border: 1rpx solid rgba(137,111,82,.12); border-radius: 22rpx; background: rgba(255,250,242,.72); }
.wifi-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx; border-bottom: 1rpx solid rgba(137,111,82,.10); }
.wifi-row:last-child { border-bottom: 0; }
.wifi-row.selected { background: rgba(210,139,45,.10); }
.wifi-row text { display: block; }
.wifi-name { max-width: 540rpx; overflow: hidden; color: #2f2923; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.wifi-meta { margin-top: 6rpx; color: #675d53; font-size: 20rpx; }
.wifi-check { color: #a76522; font-size: 28rpx; font-weight: 700; }
.wifi-empty { margin-top: 14rpx; padding: 28rpx; border-radius: 22rpx; background: rgba(255,250,242,.72); color: #675d53; font-size: 22rpx; text-align: center; }
.field-label { margin: 24rpx 0 12rpx; color: #675d53; font-size: 23rpx; }
.input { width: 100%; height: 92rpx; padding: 0 24rpx; border: 1rpx solid rgba(137,111,82,.14); border-radius: 22rpx; background: rgba(255,250,242,.72); }
.network-button { width: 100%; margin-top: 36rpx; }
.wifi-progress { margin-top: 28rpx; }
.wifi-progress-bar { height: 10rpx; overflow: hidden; border-radius: 999rpx; background: #eadfce; }
.wifi-progress-bar view { height: 100%; border-radius: 999rpx; background: #a76522; transition: width .2s ease; }
.wifi-progress text { display: block; margin-top: 10rpx; color: #675d53; font-size: 21rpx; text-align: center; }
.wifi-error { display: block; margin-top: 20rpx; color: #a45237; font-size: 22rpx; line-height: 1.5; }
.wifi-notice { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: rgba(210,139,45,.10); color: #a76522; font-size: 21rpx; line-height: 1.55; }
.wifi-notice text { flex: 1; }
.wifi-notice button { flex: 0 0 auto; margin: 0; padding: 0; color: #a76522; background: transparent; font-size: 21rpx; line-height: 1.4; }

.result-stage { text-align: center; }
.result-stage .page-title { text-align: left; }
.result-stage .page-lead { text-align: left; }
.product-result { width: 100%; height: 300rpx; margin: 56rpx 0 30rpx; border-radius: 28rpx; }
.result-stage .primary-button { width: 100%; }
