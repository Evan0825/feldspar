.detail-page { padding-top: 34rpx; }
.state-card { margin-top: 34rpx; padding: 48rpx; border-radius: 30rpx; background: #fffaf2; color: #675d53; text-align: center; }
.detail-meta { display: flex; gap: 12rpx; margin-top: 12rpx; }
.detail-meta text { padding: 11rpx 18rpx; border-radius: 999rpx; background: #ebe2d7; color: #675d53; font-size: 24rpx; }
.detail-meta text:last-child { background: #f2dfc2; color: #a76522; }
.page-title { margin-top: 30rpx; font-size: 52rpx; line-height: 1.35; }
.boundary-copy { display: block; margin-top: 20rpx; color: #675d53; font-size: 27rpx; line-height: 1.65; }
.section-title { margin-top: 46rpx; font-size: 32rpx; }
.evidence-card { margin-top: 12rpx; overflow: hidden; border: 1rpx solid rgba(137,111,82,.10); border-radius: 24rpx; background: #fffaf2; }
.evidence-card.expanded { background: #fffaf2; }
.evidence-head { display: flex; align-items: center; justify-content: space-between; min-height: 94rpx; padding: 0 28rpx; font-size: 30rpx; font-weight: 650; }
.expand { color: #a76522; font-size: 34rpx; font-weight: 400; }
.evidence-body { padding: 0 28rpx 28rpx; border-top: 1rpx solid rgba(94,75,57,.10); }
.evidence-explain { display: block; margin-top: 22rpx; color: #4c382c; font-size: 28rpx; line-height: 1.65; }
.evidence-source { display: flex; justify-content: space-between; margin-top: 20rpx; color: #675d53; font-size: 24rpx; }
.sleep-record { margin-top: 28rpx; background: #fffaf2; }
.continue-chat { margin-top: 14rpx; }
