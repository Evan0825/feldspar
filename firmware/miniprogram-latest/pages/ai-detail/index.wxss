.detail-page { padding-top: 34rpx; }
.state-card { margin-top: 34rpx; padding: 48rpx; border-radius: 30rpx; background: var(--paper); color: var(--muted); text-align: center; }
.detail-meta { display: flex; gap: 12rpx; margin-top: 12rpx; }
.detail-meta text { padding: 11rpx 18rpx; border-radius: 999rpx; background: var(--track); color: var(--muted); font-size: 24rpx; }
.detail-meta text:last-child { background: var(--amber-soft); color: var(--amber-deep); }
.page-title { margin-top: 30rpx; font-size: 52rpx; line-height: 1.35; }
.section-title { margin-top: 46rpx; font-size: 32rpx; }
.evidence-card { margin-top: 12rpx; overflow: hidden; border: 1rpx solid var(--border); border-radius: 24rpx; background: var(--paper); }
.evidence-card.expanded { background: var(--paper); }
.evidence-head { display: flex; align-items: center; justify-content: space-between; min-height: 94rpx; padding: 0 28rpx; font-size: 30rpx; font-weight: 650; }
.expand { color: var(--amber-deep); font-size: 34rpx; font-weight: 400; }
.evidence-body { padding: 0 28rpx 28rpx; border-top: 1rpx solid rgba(94,75,57,.10); }
.evidence-explain { display: block; margin-top: 22rpx; color: var(--ink); font-size: 28rpx; line-height: 1.65; }
.evidence-source { display: flex; justify-content: space-between; margin-top: 20rpx; color: var(--muted); font-size: 24rpx; }
.sleep-record { margin-top: 28rpx; background: var(--paper); }
.continue-chat { margin-top: 14rpx; }
