<view class="page detail-page">
  <view class="state-card" wx:if="{{loading}}">正在读取解读</view>
  <state-banner wx:if="{{!loading && error}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="false" />

  <block wx:if="{{!loading && interpretation}}">
    <view class="detail-meta"><text>{{interpretation.generatedAt}} · {{interpretation.kind === 'seven-night' ? '7 晚' : '单晚'}}</text><text>数据质量 {{interpretation.dataQuality}}</text></view>
    <view class="page-title">{{interpretation.conclusion}}</view>
    <text class="boundary-copy">这是事件与体位的趋势关联，不用于判断具体疾病。</text>

    <view class="section-title">判断依据</view>
    <view class="evidence-card {{selectedEvidenceId === item.id ? 'expanded' : ''}}" wx:for="{{interpretation.evidence}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleEvidence">
      <view class="evidence-head"><text>{{item.metric}}</text><text class="expand">{{selectedEvidenceId === item.id ? '−' : '+'}}</text></view>
      <view wx:if="{{selectedEvidenceId === item.id}}" class="evidence-body">
        <text class="evidence-explain">{{item.explanation}}</text>
        <view class="evidence-source"><text>{{item.value}}{{item.unit}} · {{item.window}}</text><text>{{interpretation.sourceLabel}}</text></view>
      </view>
    </view>

    <button hover-class="none" class="secondary-button sleep-record" bindtap="openSleepRecord">查看原始睡眠记录</button>
    <button hover-class="none" class="primary-button continue-chat" bindtap="openChat">针对本次继续追问</button>
  </block>

  <view class="safe-note">用于趋势观察与体位提醒，不替代医疗检查</view>
</view>
