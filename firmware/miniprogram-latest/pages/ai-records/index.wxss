.records-page { min-height: 0; padding: 30rpx 36rpx 60rpx; }
.records-toolbar { display: flex; justify-content: flex-end; margin-bottom: 16rpx; }
.new-conversation { margin: 0; padding: 10rpx 0 10rpx 16rpx; color: var(--amber-deep); background: transparent; font-size: 27rpx; line-height: 1.6; }
.records-tabs { display: flex; border: 1rpx solid var(--border); border-radius: 26rpx; margin: 8rpx 0 46rpx; background: var(--ivory); padding: 5rpx; }
.records-tabs button { flex: 1; margin: 0; padding: 20rpx 0; font-size: 33rpx; line-height: 1.4; background: transparent; border-radius: 22rpx; color: var(--muted); }
.records-tabs button.active { color: var(--amber-deep); background: var(--amber-soft); }
.group-label { display: block; font-size: 28rpx; color: #8b7b67; margin: 38rpx 4rpx 18rpx; }
.record-list { padding: 0 28rpx; background: var(--paper); border: 1rpx solid var(--border); border-radius: 28rpx; }
.record-item { padding: 28rpx 0 31rpx; border-bottom: 1rpx solid var(--border); }
.record-item:last-child { border: 0; }
.record-meta { display: flex; gap: 18rpx; font-size: 25rpx; line-height: 1.4; color: #927d64; margin-bottom: 14rpx; }
.record-meta text + text { color: var(--amber-deep); }
.record-heading { display: flex; align-items: center; gap: 20rpx; }
.record-heading > text { flex: 1; font-size: 36rpx; font-weight: 650; line-height: 1.5; }
.record-heading image { width: 26rpx; height: 26rpx; flex-shrink: 0; }
.record-preview { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 28rpx; color: var(--muted); line-height: 1.7; margin-top: 13rpx; }
.records-loading, .records-note { display: block; text-align: center; color: var(--muted); font-size: 25rpx; margin: 35rpx 0; }
.empty-records { padding: 72rpx 18rpx; text-align: center; }
.empty-records > image { width: 75rpx; height: 75rpx; margin-bottom: 25rpx; }
.empty-records > text { display: block; font-size: 36rpx; line-height: 1.6; }
.records-access { color: var(--muted); font-size: 27rpx; line-height: 1.7; }
.records-access .ai-home-link { margin: 8rpx 0; padding: 14rpx 0; background: transparent; color: var(--amber-deep); font-size: 27rpx; line-height: 1.5; text-align: left; }
.record-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.record-delete { flex-shrink: 0; margin: 0 0 0 auto; padding: 12rpx 0 12rpx 20rpx; font-size: 26rpx; line-height: 1.5; color: #9b6a43; background: transparent; }
