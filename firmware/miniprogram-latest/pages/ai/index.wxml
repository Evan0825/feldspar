<view class="page ai-page">
  <view class="daily-toolbar"><button hover-class="none" class="records-link" bindtap="openRecords">对话记录</button></view>
  <view class="daily-hero">
    <view><text class="hero-title">睡眠解读</text></view>
    <image class="period-icon" src="/images/ai-ui/{{daily.period === 'evening' ? 'moon' : (daily.period === 'morning' ? 'sunrise' : 'sun')}}.png" mode="aspectFit" />
  </view>
  <view class="loading-card" wx:if="{{loading}}"><view class="skeleton-line" /><view class="skeleton-line short" /><text>正在整理最近记录</text></view>
  <state-banner wx:if="{{!loading && error}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="{{error.retryable}}" bindretry="load" />
  <view class="consent-card" wx:if="{{!loading && consentRequired}}">
    <image src="/images/tab-ai-active.png" mode="aspectFit" /><text class="card-title">AI 数据授权</text>
    <text class="card-copy">读取睡眠记录与反馈，用于解读。</text>
    <button hover-class="none" class="primary-button" disabled="{{authorizing}}" bindtap="requestAiConsent">{{authorizing ? '正在确认' : '授权使用'}}</button>
    <button hover-class="none" class="continue-link" bindtap="openMemory">AI 记忆</button>
  </view>
  <block wx:if="{{!loading && daily && !consentRequired}}">
    <view class="assistant-row">
      <view class="assistant-avatar"><image src="/images/tab-ai-active.png" mode="aspectFit" /></view>
      <view class="daily-card">
        <view class="card-top"><text class="assistant-label">AI</text><text class="source-label" wx:if="{{daily.sourceDate}}">{{daily.sourceDate}} · {{daily.overview.sourceLabel || '睡眠记录'}}</text></view>
        <text class="card-title" wx:if="{{daily.empty}}">{{daily.messageTitle}}</text>
        <text class="card-copy">{{daily.messageText}}</text>
        <button hover-class="none" wx:if="{{!daily.empty}}" class="message-action" bindtap="askWhy"><text>{{daily.messageAction || '为什么这样判断？'}}</text><image src="/images/ai-ui/chevron-right.png" mode="aspectFit" /></button>
        <button hover-class="none" wx:else class="message-action" bindtap="openChat"><text>先聊聊睡眠习惯</text><image src="/images/ai-ui/chevron-right.png" mode="aspectFit" /></button>
      </view>
    </view>
    <view class="source-actions" wx:if="{{!daily.empty}}">
      <button hover-class="none" class="source-record-link" bindtap="openRecordSource">查看睡眠记录</button>
      <button hover-class="none" wx:if="{{daily.overview.kind === 'single-night'}}" class="source-record-link" bindtap="openPlan">查看今晚建议</button>
    </view>
    <view class="questions-section"><text class="section-title">推荐问题</text>
      <button hover-class="none" class="question-row" wx:for="{{daily.questions}}" wx:if="{{index < 2}}" wx:key="id" data-question="{{item.text}}" bindtap="askQuestion"><image class="question-icon" src="/images/ai-ui/{{index === 0 ? 'lightbulb' : (index === 1 ? 'coffee' : 'moon')}}.png" mode="aspectFit" /><text>{{item.text}}</text><image class="row-arrow" src="/images/ai-ui/chevron-right.png" mode="aspectFit" /></button>
    </view>
    <button hover-class="none" wx:if="{{daily.activeSessionId}}" class="continue-link" bindtap="openChat">继续今天的对话 <text>›</text></button>
    <view class="memory-row"><image src="/images/ai-ui/brain.png" mode="aspectFit" /><text>{{daily.memorySummary ? '已记住：' + daily.memorySummary : '未设置记忆'}}</text><button hover-class="none" bindtap="openMemory">AI 记忆</button></view>
    <view class="home-composer"><view class="home-input-row"><input placeholder="输入问题…" placeholder-class="input-placeholder" maxlength="1000" value="{{question}}" bindinput="onQuestionInput" confirm-type="send" bindconfirm="sendQuestion" /><button hover-class="none" class="send-button" disabled="{{!question}}" bindtap="sendQuestion" aria-label="发送问题"><image src="/images/ai-ui/arrow-up.png" mode="aspectFit" /></button></view><text class="ai-boundary">不替代医疗检查</text></view>
  </block>
</view>
