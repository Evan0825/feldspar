.ai-page { min-height: 0; padding: 20rpx 32rpx 210rpx; }
.daily-toolbar { display: flex; justify-content: flex-end; align-items: center; min-height: 56rpx; }
.records-link { margin: 0; padding: 14rpx 0 14rpx 28rpx; color: var(--amber-deep); background: transparent; font-size: 32rpx; line-height: 1.4; }
.daily-hero { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 28rpx 0 34rpx; }
.daily-hero > view { flex: 1; min-width: 0; }
.hero-title { display: block; font-size: 53rpx; font-weight: 650; line-height: 1.38; letter-spacing: 1rpx; color: var(--ink); }
.period-icon { flex-shrink: 0; width: 75rpx; height: 75rpx; margin-right: 5rpx; }
.assistant-row { display: flex; gap: 16rpx; align-items: flex-start; }
.assistant-avatar { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border: 1rpx solid var(--border); border-radius: 50%; background: var(--paper); }
.assistant-avatar image { width: 38rpx; height: 38rpx; }
.daily-card { flex: 1; min-width: 0; padding: 32rpx 28rpx 26rpx; border: 1rpx solid var(--border); border-radius: 34rpx; background: var(--paper); }
.card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8rpx; margin-bottom: 24rpx; }
.assistant-label { color: var(--amber-deep); font-size: 28rpx; font-weight: 500; }
.source-label { font-size: 22rpx; color: var(--muted); }
.card-title { display: block; font-size: 37rpx; font-weight: 650; line-height: 1.5; }
.card-copy { display: block; font-size: 30rpx; color: #706354; line-height: 1.8; margin-top: 17rpx; }
.message-action { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 19rpx 0 4rpx; margin: 16rpx 0 0; text-align: left; background: transparent; color: var(--amber-deep); font-size: 29rpx; line-height: 1.5; }
.message-action image { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.questions-section { margin-top: 30rpx; }
.section-title { display: block; font-size: 31rpx; font-weight: 500; margin: 0 0 21rpx 4rpx; }
.question-row { display: flex; align-items: center; gap: 22rpx; min-height: 100rpx; padding: 20rpx 25rpx; margin: 12rpx 0 0; border: 1rpx solid var(--border); border-radius: 29rpx; background: var(--ivory); text-align: left; line-height: 1.5; color: var(--ink); font-size: 30rpx; }
.question-row > text { flex: 1; }
.question-icon { width: 42rpx; height: 42rpx; flex-shrink: 0; }
.row-arrow { width: 24rpx; height: 24rpx; flex-shrink: 0; }
.continue-link { margin: 22rpx 0 0; padding: 8rpx; background: transparent; color: var(--amber-deep); font-size: 28rpx; line-height: 1.6; }
.continue-link text { margin-left: 10rpx; }
.memory-row { display: flex; align-items: center; gap: 10rpx; margin: 32rpx 4rpx 16rpx; color: var(--muted); }
.memory-row > image { width: 31rpx; height: 31rpx; flex-shrink: 0; }
.memory-row > text { flex: 1; min-width: 0; font-size: 24rpx; line-height: 1.5; }
.memory-row button { flex-shrink: 0; background: transparent; padding: 10rpx 0 10rpx 6rpx; margin: 0; font-size: 25rpx; line-height: 1.5; color: var(--amber-deep); }
.home-composer { position: fixed; z-index: 5; bottom: 12rpx; left: 32rpx; right: 32rpx; display: flex; flex-direction: column; gap: 12rpx; padding: 18rpx 23rpx 14rpx 28rpx; border: 1rpx solid var(--border); border-radius: 33rpx; background: var(--paper); box-sizing: border-box; }
.home-input-row { display: flex; align-items: center; gap: 16rpx; width: 100%; }
.home-composer .ai-boundary { margin: 0; font-size: 22rpx; line-height: 1.5; }
.home-composer input { flex: 1; height: 64rpx; font-size: 32rpx; min-width: 0; }
.input-placeholder { color: #a99b89; }
.send-button { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 65rpx; height: 65rpx; padding: 0; margin: 0; border-radius: 50%; background: var(--amber); }
.ai-page .home-composer .send-button[disabled] { background-color: var(--border); opacity: .65; }
.send-button image { width: 37rpx; height: 37rpx; }
.ai-boundary { display: block; margin-top: 25rpx; color: var(--muted); text-align: center; font-size: 22rpx; line-height: 1.7; }
.consent-card, .loading-card { border: 1rpx solid var(--border); background: var(--paper); border-radius: 34rpx; padding: 36rpx; }
.consent-card > image { width: 50rpx; height: 50rpx; margin-bottom: 18rpx; }
.consent-card .primary-button { margin-top: 36rpx; }
.loading-card text { display: block; color: var(--muted); font-size: 28rpx; margin-top: 28rpx; }
.skeleton-line { width: 85%; height: 28rpx; border-radius: 8rpx; background: var(--track); margin-bottom: 22rpx; }
.skeleton-line.short { width: 65%; }

.source-actions { display: flex; gap: 32rpx; margin: 14rpx 0 16rpx; }
.source-record-link { margin: 0; padding: 8rpx 4rpx; background: transparent; color: var(--amber-deep); font-size: 25rpx; }
