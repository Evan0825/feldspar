.ai-page { padding-top: 44rpx; }
.welcome-row { display: flex; min-height: 64rpx; align-items: center; justify-content: flex-end; }
.records-link,.back-link { width: auto; min-height: 64rpx; margin: 0; padding: 0; background: transparent; color: #a76522; font-size: 28rpx; line-height: 64rpx; }
.hero-copy { margin-top: 8rpx; }
.hero-title { display: block; max-width: 660rpx; font-family: "Songti SC","STSong",serif; font-size: 52rpx; font-weight: 600; line-height: 1.3; letter-spacing: 1rpx; }
.state-card { margin-top: 30rpx; padding: 46rpx; border: 1rpx solid #eadfd2; border-radius: 32rpx; background: #fffdf9; color: #675d53; text-align: center; }
.consent-card { margin-top: 32rpx; padding: 34rpx 30rpx; border: 1rpx solid #eadfd2; border-radius: 32rpx; background: #fffdf9; }
.consent-title,.consent-copy { display: block; }
.consent-title { font-family: "Songti SC",serif; font-size: 36rpx; font-weight: 600; line-height: 1.4; }
.consent-copy { margin-top: 16rpx; color: #675d53; font-size: 27rpx; line-height: 1.65; }
.consent-button { margin-top: 28rpx; }
.conclusion-card,.plan-card,.ask-card { margin-top: 28rpx; border: 1rpx solid #eadfd2; border-radius: 36rpx; background: #fffdf9; }
.conclusion-card { padding: 34rpx 30rpx 16rpx; }
.ai-label,.plan-label { display: flex; align-items: center; gap: 10rpx; color: #d67808; font-size: 27rpx; font-weight: 650; }
.label-icon { width: 34rpx; height: 34rpx; }
.conclusion-title { display: block; margin-top: 24rpx; font-family: "Songti SC",serif; font-size: 40rpx; font-weight: 600; line-height: 1.38; }
.conclusion-copy { display: -webkit-box; margin-top: 14rpx; overflow: hidden; color: #675d53; font-size: 28rpx; line-height: 1.62; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.evidence-link { display: flex; align-items: center; justify-content: flex-start; gap: 12rpx; width: 100%; min-height: 76rpx; margin: 10rpx 0 0; padding: 0; background: transparent; color: #a76522; text-align: left; font-size: 26rpx; }
.evidence-toggle { font-size: 28rpx; }
.evidence-list { padding-bottom: 10rpx; border-top: 1rpx solid rgba(94,75,57,.11); }
.evidence-item { padding: 22rpx 0; border-bottom: 1rpx solid rgba(94,75,57,.11); }
.evidence-head { display: flex; align-items: center; justify-content: space-between; color: #4c382c; font-size: 27rpx; }
.evidence-head text:first-child { font-weight: 650; }
.evidence-head text:last-child { color: #a76522; }
.evidence-body text { display: block; }
.evidence-body text:first-child { margin-top: 12rpx; color: #675d53; font-size: 26rpx; line-height: 1.6; }
.evidence-body text:last-child { margin-top: 8rpx; color: #948575; font-size: 23rpx; }
.plan-card { padding: 32rpx 30rpx 26rpx; }
.plan-title { display: block; margin-top: 24rpx; font-family: "Songti SC",serif; font-size: 38rpx; font-weight: 600; line-height: 1.35; }
.plan-summary { display: block; margin-top: 12rpx; overflow: hidden; color: #675d53; font-size: 26rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.plan-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.plan-actions button { flex: 1; width: auto; min-width: 0; height: 80rpx; margin: 0; border-radius: 22rpx; font-size: 26rpx; line-height: 80rpx; }
.plan-apply { color: #fff; }
.manual-button { border: 1rpx solid #dfaa61; background: #fff4df; color: #aa6416; font-weight: 600; }
.plan-detail-link { width: 100%; min-height: 64rpx; margin: 8rpx 0 0; padding: 0; background: transparent; color: #a76522; font-size: 24rpx; line-height: 64rpx; }
.plan-detail { padding: 18rpx 0 4rpx; border-top: 1rpx solid rgba(94,75,57,.11); }
.plan-detail text { display: block; color: #675d53; font-size: 25rpx; line-height: 1.58; }
.plan-detail text:last-child { margin-top: 8rpx; font-size: 22rpx; }
.inline-command { margin-top: 20rpx; padding: 20rpx; border-radius: 20rpx; background: rgba(210,139,45,.09); }
.inline-command text { display: block; }
.inline-command .command-title { font-size: 27rpx; font-weight: 650; }
.inline-command .command-title.success { color: #536c2d; }
.inline-command .command-copy { margin-top: 7rpx; color: #675d53; font-size: 24rpx; line-height: 1.5; }
.inline-retry { min-height: 72rpx; margin-top: 16rpx; border-radius: 20rpx; font-size: 23rpx; }
.command-banner { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 26rpx 28rpx; border-radius: 26rpx; background: #f2dfc2; }
.command-banner text { display: block; }
.command-banner view text:first-child { font-size: 28rpx; font-weight: 650; }
.command-banner view text:last-child { margin-top: 7rpx; color: #675d53; font-size: 24rpx; }
.ask-card { display: flex; min-height: 132rpx; align-items: center; gap: 20rpx; padding: 0 28rpx; }
.ask-icon { display: flex; width: 66rpx; height: 66rpx; flex: 0 0 66rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #fff2dc; color: #d67808; font-size: 32rpx; }
.ask-icon image { width: 38rpx; height: 38rpx; }
.ask-copy { flex: 1; min-width: 0; }
.ask-copy text { display: block; }
.ask-copy text:first-child { font-family: "Songti SC",serif; font-size: 34rpx; font-weight: 600; }
.ask-copy text:last-child { margin-top: 8rpx; color: #675d53; font-size: 25rpx; }
.arrow { color: #9d8d7c; font-size: 40rpx; font-weight: 300; }
.records-toolbar { display: flex; min-height: 64rpx; align-items: center; }
.record-filter { display: flex; margin-top: 28rpx; border: 1rpx solid #e6d9ca; border-radius: 24rpx; overflow: hidden; background: rgba(255,253,249,.55); }
.filter-chip { flex: 1; width: auto; min-width: 0; height: 76rpx; margin: 0; padding: 0 18rpx; border-radius: 0; background: transparent; color: #675d53; font-size: 28rpx; line-height: 76rpx; }
.filter-chip + .filter-chip { border-left: 1rpx solid #e6d9ca; }
.filter-chip.active { background: #fff0d7; color: #c96d05; font-weight: 650; }
.record-list { margin-top: 28rpx; padding: 0 28rpx; overflow: hidden; border: 1rpx solid #eadfd2; border-radius: 30rpx; background: #fffdf9; }
.record-card { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 0; padding: 32rpx 0; border-bottom: 1rpx solid #eadfd2; border-radius: 0; background: transparent; }
.record-card:last-child { border-bottom: 0; }
.record-card > view { min-width: 0; }
.record-card text { display: block; }
.record-top { display: flex; gap: 14rpx; color: #675d53; font-size: 24rpx; }
.record-top text:last-child { color: #a76522; }
.record-title { margin-top: 14rpx; font-family: "Songti SC",serif; font-size: 34rpx; font-weight: 600; line-height: 1.35; }
.record-meta { display: -webkit-box; margin-top: 9rpx; overflow: hidden; color: #675d53; font-size: 26rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.data-boundary { margin-top: 26rpx; color: #675d53; text-align: center; font-size: 23rpx; line-height: 1.55; }
