<view class="page home-page">
  <view class="home-header">
    <view class="device-pill" aria-label="月石床头主机状态" wx:if="{{status}}" bindtap="openDevice"><view class="status-dot {{status.host.online ? '' : 'offline'}}"></view><text>{{deviceLinkLabel}}</text></view>
  </view>

  <view class="state-card" wx:if="{{loading}}"><text class="state-title">正在同步今晚状态</text></view>
  <state-banner wx:elif="{{error}}" tone="danger" title="{{error.title}}" detail="{{error.detail}}" retryable="{{error.retryable}}" action="{{error.action}}" bindretry="retryDevice" bindaction="handleDeviceAction" />

  <block wx:else>
    <state-banner wx:if="{{partialError}}" tone="warning" title="部分状态暂未同步" detail="{{partialError.detail}}" retryable="{{partialError.retryable}}" action="{{partialError.action}}" bindretry="retryDevice" bindaction="handleDeviceAction" />
    <view class="hero-copy"><text class="hero-title">{{status.safety.available && status.safety.stopLatched ? '手动控制已暂停' : status.controlAvailable || status.cloudSoundAvailable && status.cloudLightAvailable ? '手动控制可用' : status.cloudSoundAvailable || status.cloudLightAvailable ? '部分控制可用' : '设备待就绪'}}</text></view>
    <view class="pad-banner" wx:if="{{controlStatusPending && !(status.cloudLightAvailable && status.cloudSoundAvailable)}}">{{status.cloudLightAvailable ? '声音控制待设备确认。' : status.cloudSoundAvailable ? '夜灯控制待设备确认。' : '设备安全状态待确认，声音和夜灯暂不可用。'}}</view>
    <view class="pad-banner" wx:elif="{{status.safety.available && status.safety.stopLatched}}" role="button" bindtap="openDevice">恢复手动控制 ›</view>
    <view class="pad-banner" wx:if="{{padNotice}}">{{padNotice}}</view>

    <view class="product-stage" aria-label="月石床头主机与枕下定向振动片" bindtap="openLive"><image src="/images/system-hero.png" mode="aspectFit" /></view>

    <view class="strategy-card" wx:if="{{strategy && !strategyError}}">
      <view class="strategy-label">当前温和方案</view>
      <view class="strategy-title-row"><text class="strategy-title">{{strategy.title}}</text><text class="strategy-badge">{{strategy.badge}}</text></view>
      <text class="strategy-progress-label">{{strategy.progressLabel}}</text>
      <view class="strategy-progress" wx:if="{{strategy.progressPercent !== null}}"><view style="width: {{strategy.progressPercent}}%" /></view>
      <button hover-class="none" class="primary-button tonight-button" bindtap="openStrategy">查看方案</button>
    </view>
    <view class="strategy-card strategy-empty" wx:elif="{{strategyLoading}}">正在读取方案</view>
    <view class="strategy-card strategy-empty" wx:else bindtap="openStrategy"><text>方案待同步</text><text class="arrow">›</text></view>

    <view class="control-grid">
      <view role="button" aria-label="{{sound.playing ? '声音，正在播放' : '声音，未播放'}}" class="control-card {{sound.playing ? 'sound-active' : ''}} {{!status.controlAvailable && !status.cloudSoundAvailable ? 'disabled' : ''}}" bindtap="openSound"><image class="sound-icon" src="/images/ui/sound{{sound.playing ? '-active' : ''}}.png" mode="aspectFit" /><text>声音</text></view>
      <view role="button" aria-label="{{light.enabled ? '夜灯，已开启' : '夜灯，未开启'}}" class="control-card {{light.enabled ? 'light-active' : ''}} {{!status.controlAvailable && !status.cloudLightAvailable ? 'disabled' : ''}}" bindtap="openLight"><image class="light-icon" src="/images/host-detail.png" mode="aspectFit" /><text>夜灯</text></view>
    </view>
    <view class="shortcut-list">
      <view class="shortcut-row home-ai-row" bindtap="openAi"><image src="/images/ui/chat.png" mode="aspectFit" /><text>问 AI</text><text class="arrow">›</text></view>
      <view class="shortcut-row" bindtap="openLive"><image src="/images/ui/activity.png" mode="aspectFit" /><text>实时状态</text><text class="arrow">›</text></view>
    </view>

    <view class="command-banner" wx:if="{{activeCommand && activeCommand.status !== 'applied'}}" bindtap="openActiveCommand"><text>{{activeCommand.status === 'pending' || activeCommand.status === 'readback-pending' ? '今晚设置等待设备确认' : '查看今晚设置结果'}}</text><text class="arrow">›</text></view>

  </block>

  <view class="report-shortcut" wx:if="{{morningReportState === 'loading'}}"><text>正在同步睡眠记录</text></view>
  <state-banner wx:elif="{{morningReportState === 'error'}}" tone="danger" title="{{morningReportError.title}}" detail="{{morningReportError.detail}}" retryable="{{morningReportError.retryable}}" action="{{morningReportError.action}}" bindretry="retryMorningReport" bindaction="handleMorningReportAction" />
  <view class="report-shortcut" wx:else bindtap="openReport"><text>{{morningReportCopy}}</text><text class="arrow">›</text></view>
</view>
