.self-check-page { padding: 24rpx 48rpx 46rpx; }

.ready-state,
.checking-state,
.failed-state {
  min-height: calc(100vh - 150rpx);
}

.ready-mark {
  display: block;
  width: 108rpx;
  height: 108rpx;
  margin: 22rpx auto 28rpx;
  overflow: hidden;
  border-radius: 50%;
}

.ready-title {
  margin-top: 0;
  font-size: 64rpx;
  line-height: 1.22;
  text-align: center;
}

.ready-lead {
  margin-top: 14rpx;
  font-size: 24rpx;
  text-align: center;
}

.product-hero {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
}

.ready-hero {
  height: 286rpx;
  margin: 28rpx 0 8rpx;
  transform: scale(1.5);
  transform-origin: center;
}

.status-list {
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(137, 111, 82, .16);
}

.status-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid rgba(137, 111, 82, .16);
}

.status-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 22rpx;
  overflow: hidden;
  border-radius: 50%;
}

.status-label {
  flex: 1;
  color: #2f2923;
  font-size: 28rpx;
  font-weight: 500;
}

.status-value {
  color: #536c2d;
  font-size: 27rpx;
  font-weight: 600;
}

.settings-row {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  width: 100%;
  min-height: 104rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border-top: 1rpx solid rgba(137, 111, 82, .16);
  border-bottom: 1rpx solid rgba(137, 111, 82, .16);
  border-radius: 0;
  background: transparent;
  color: #2f2923;
  font-size: 24rpx;
  line-height: 1.3;
}

.settings-label {
  font-weight: 600;
}

.settings-summary {
  margin-left: 22rpx;
  color: #675d53;
  text-align: left;
}

.settings-action {
  color: #a76522;
  font-weight: 600;
}

.complete-button {
  width: 100%;
  min-height: 104rpx;
  margin-top: 42rpx;
  line-height: 104rpx;
}

.local-note,
.checking-copy {
  color: #8f8377;
  font-size: 21rpx;
  text-align: center;
}

.local-note {
  margin-top: 22rpx;
}

.checking-state .page-title,
.failed-state .page-title {
  margin-top: 28rpx;
  font-size: 54rpx;
}

.checking-hero {
  height: 300rpx;
  margin: 64rpx 0 18rpx;
}

.checking-copy {
  margin-top: 24rpx;
}

.failed-hero {
  height: 236rpx;
  margin: 42rpx 0 16rpx;
}

.failed-list {
  border-top: 1rpx solid rgba(137, 111, 82, .16);
}

.failed-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(137, 111, 82, .16);
}

.failed-label,
.failed-detail {
  display: block;
}

.failed-label {
  color: #2f2923;
  font-size: 25rpx;
  font-weight: 600;
}

.failed-detail {
  margin-top: 8rpx;
  color: #675d53;
  font-size: 21rpx;
  line-height: 1.55;
}

.error-card {
  padding: 12rpx 0 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.retry-button {
  width: 100%;
  margin-top: 28rpx;
}
