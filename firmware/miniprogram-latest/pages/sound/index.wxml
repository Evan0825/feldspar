<view class="page sound-page">
  <view class="state-card" wx:if="{{loading}}"><text class="state-title">正在读取声音状态</text></view>
  <state-banner wx:elif="{{loadError}}" tone="danger" title="{{loadError.title}}" detail="{{loadError.detail}}" retryable="{{loadError.retryable}}" action="{{loadError.action}}" bindretry="retry" bindaction="handleServiceAction" />
  <view class="empty-state" wx:elif="{{phase === 'empty'}}">暂无声音设置，请确认设备连接。</view>
  <block wx:else>
    <state-banner wx:if="{{actionError}}" tone="danger" title="{{actionError.title}}" detail="{{actionError.detail}}" retryable="{{actionError.retryable}}" action="{{actionError.action}}" bindretry="retryAction" bindaction="handleActionError" />
    <state-banner wx:if="{{controlError}}" tone="warning" title="{{controlError.title}}" detail="{{controlError.detail}}" retryable="{{controlError.retryable}}" action="{{controlError.action}}" bindretry="retry" bindaction="handleServiceAction" />
    <state-banner wx:elif="{{sound.syncPending}}" tone="warning" title="设备已确认，云端待同步" />
    <state-banner wx:elif="{{!sound.confirmed && status.ble.connected}}" tone="warning" title="设备播放状态待确认" />

    <image class="product-visual" src="/images/system-hero.png" mode="aspectFit" aria-label="月石床头主机与枕下振动片" />
    <view class="card player-card">
      <view class="row player-track">
        <text class="track-name">{{sound.trackName || sound.sceneName}}</text>
        <text wx:if="{{controlAvailable ? sound.playing : previewPlaying}}" class="playback-target">{{controlAvailable ? '设备播放中' : '手机试听中'}}</text>
      </view>
      <button hover-class="none" class="primary-button play-button" loading="{{syncing}}" disabled="{{syncing}}" bindtap="togglePlayback">
        <image wx:if="{{!syncing}}" src="/images/ui/{{controlAvailable ? (sound.playing ? 'stop' : 'play') : (previewPlaying ? 'pause' : 'play')}}.png" mode="aspectFit" />
        <text>{{controlAvailable ? (sound.playing ? '停止播放' : '播放到设备') : (previewPlaying ? '暂停试听' : '手机试听')}}</text>
      </button>
      <text class="preview-error" wx:if="{{previewError}}">{{previewError}}</text>
      <view class="volume-control">
        <view class="row"><view class="sound-label"><image src="/images/ui/volume.png" mode="aspectFit" /><text>音量</text></view><text class="control-value">{{volumeDraft}}%</text></view>
        <slider min="0" max="100" value="{{volumeDraft}}" disabled="{{syncing}}" aria-label="音量" activeColor="#F9C747" backgroundColor="#EAE2D5" block-color="#FFFDF8" block-size="26" bindchanging="previewVolume" bindchange="setVolume" />
      </view>
    </view>

    <view class="card playback-settings" wx:if="{{controlAvailable}}">
      <view class="row manual-stop" wx:if="{{manualStopOnly}}"><text>定时关闭</text><text>{{timerUnavailableText}}</text></view>
      <block wx:else>
        <view class="row"><text class="sound-label">定时关闭</text><text wx:if="{{timerLabel}}" class="control-value">{{timerLabel}}</text></view>
        <view class="chip-row timer-options"><button hover-class="none" wx:for="{{timers}}" wx:key="*this" role="radio" aria-checked="{{sound.timer === item}}" class="chip {{sound.timer === item ? 'active' : ''}}" data-timer="{{item}}" disabled="{{syncing}}" bindtap="setTimer">{{item === 'all-night' ? '不定时' : item + ' 分钟'}}</button></view>
      </block>
    </view>

    <view class="section-title">声音场景</view>
    <view class="scene-grid">
      <button wx:for="{{sound.scenes}}" wx:key="id" hover-class="none" role="radio" aria-checked="{{sound.scene === item.id}}" class="scene-card {{sound.scene === item.id ? 'active' : ''}}" disabled="{{syncing}}" data-scene="{{item.id}}" bindtap="selectScene">
        <image src="/images/ui/scene-{{sceneIcons[item.id] || 'default'}}{{sound.scene === item.id ? '-active' : ''}}.png" mode="aspectFit" /><text>{{item.name}}</text>
      </button>
    </view>

    <view class="card upload-card">
      <view class="row"><view class="sound-label"><image src="/images/ui/upload.png" mode="aspectFit" /><text>自定义音效</text></view><text class="control-value" wx:if="{{uploading}}">{{uploadProgress}}%</text></view>
      <button hover-class="none" class="secondary-button upload-button" loading="{{uploading}}" disabled="{{!canUpload || uploading}}" bindtap="chooseAndUploadWav">同步 WAV 文件</button>
      <text class="upload-note" wx:if="{{!canUpload}}">通过真机蓝牙连接后可同步。</text>
    </view>
  </block>
</view>
