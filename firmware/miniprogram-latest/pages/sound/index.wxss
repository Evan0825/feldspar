.sound-page { padding-top: 22rpx; }
.player-card { margin-top: 0; }
.player-track { align-items: flex-start; }
.track-name { min-width: 0; font-size: 36rpx; line-height: 1.35; font-weight: 700; overflow-wrap: anywhere; }
.playback-target { flex-shrink: 0; padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--success-soft); color: var(--success); font-size: 23rpx; }
.play-button { width: 100%; gap: 12rpx; margin: 22rpx 0 0; }
.play-button image { width: 38rpx; height: 38rpx; }
.volume-control { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.volume-control slider { margin: 22rpx 0 0; }
.sound-label { display: flex; align-items: center; gap: 10rpx; font-size: 28rpx; font-weight: 650; }
.sound-label image { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.control-value { color: var(--amber-deep); font-size: 28rpx; font-weight: 650; font-variant-numeric: tabular-nums; }
.scene-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.scene-card { display: flex; align-items: center; gap: 12rpx; min-width: 0; min-height: 88rpx; margin: 0; padding: 12rpx 20rpx; border: 2rpx solid var(--border); border-radius: 30rpx; background: var(--paper); color: var(--ink); text-align: left; font-size: 27rpx; line-height: 1.35; }
.scene-card image { width: 37rpx; height: 37rpx; flex-shrink: 0; }
.scene-card.active { border-color: var(--amber-edge); background: var(--amber-soft); color: var(--amber-deep); font-weight: 650; }
.manual-stop { font-size: 27rpx; }
.manual-stop text:last-child { color: var(--muted); }
.timer-options { margin-top: 16rpx; gap: 10rpx; }
.timer-options .chip { flex: 1 0 auto; margin: 0; padding: 0 10rpx; line-height: 1.2; }
.upload-button { margin: 16rpx 0 0; font-size: 27rpx; }
.upload-note,.preview-error { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.45; }
.preview-error { color: var(--danger); }
.state-card { padding: 28rpx; border-radius: 28rpx; background: var(--paper); text-align: center; }
.state-title { font-weight: 650; }
