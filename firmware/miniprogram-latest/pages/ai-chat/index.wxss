page { height: 100%; overflow: hidden; background: var(--ivory); }
.chat-page { display: flex; flex-direction: column; box-sizing: border-box; height: 100vh; overflow: hidden; background: var(--ivory); }
.chat-page button { box-shadow: none; }
.chat-page image { flex-shrink: 0; }
.chat-toolbar { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; min-height: 94rpx; padding: 8rpx 34rpx; border-bottom: 1rpx solid var(--border); gap: 18rpx; }
.chat-toolbar .ai-home-entry { flex-shrink: 0; width: auto; min-height: 76rpx; margin: 0; padding: 0 8rpx; background: transparent; color: var(--muted); font-size: 29rpx; line-height: 76rpx; }
.context-source { display: flex; flex-shrink: 0; align-items: center; min-width: 0; padding: 18rpx 34rpx 6rpx; gap: 10rpx; font-size: 26rpx; color: var(--muted); }
.context-source image { width: 27rpx; height: 27rpx; }
.context-source text { white-space: normal; line-height: 1.6; }
.toolbar-actions { display: flex; flex-shrink: 0; align-items: center; gap: 20rpx; }
.toolbar-actions button { width: auto; min-height: 76rpx; margin: 0; padding: 0 8rpx; color: var(--amber-deep); font-size: 32rpx; line-height: 76rpx; background: transparent; }
.toolbar-actions .new-chat { display: flex; align-items: center; justify-content: center; width: 64rpx; }
.new-chat image { width: 38rpx; height: 38rpx; }
.toolbar-actions button[disabled] { color: #aea397; }
.conversation-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
.conversation-content { padding: 12rpx 34rpx 4rpx; }
.session-heading { display: block; margin: 32rpx 0 20rpx; font-size: 42rpx; line-height: 1.5; color: var(--ink); }
.assistant-intro { margin-top: 34rpx; }
.assistant-role { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; color: var(--amber-deep); font-size: 30rpx; }
.assistant-role image { width: 44rpx; height: 44rpx; }
.context-conclusion { display: block; margin-top: 24rpx; font-size: 42rpx; line-height: 1.5; color: var(--ink); }
.context-summary { display: block; margin-top: 20rpx; color: var(--muted); font-size: 32rpx; line-height: 1.75; }
.quick-row { display: flex; flex-direction: column; gap: 18rpx; margin: 34rpx 0; }
.quick-row button { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 96rpx; padding: 22rpx 26rpx; margin: 0; border: 1rpx solid var(--border); border-radius: 26rpx; background: var(--paper); color: var(--ink); font-size: 30rpx; text-align: left; line-height: 1.6; }
.quick-row image { width: 24rpx; height: 24rpx; margin-left: 16rpx; }
.message-date { display: flex; align-items: center; justify-content: center; margin: 40rpx 0 30rpx; gap: 20rpx; color: var(--muted); font-size: 26rpx; }
.message-date::before,.message-date::after { display: block; content: ''; width: 74rpx; height: 1rpx; background: var(--border); }
.message { margin: 28rpx 0 36rpx; }
.message-bubble { padding: 28rpx 30rpx; border: 1rpx solid var(--border); border-radius: 8rpx 32rpx 32rpx; background: var(--paper); }
.message-text { display: block; color: var(--ink); font-size: 34rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: break-word; }
.message.user { display: flex; justify-content: flex-end; margin: 30rpx 0 44rpx; }
.message.user .message-bubble { max-width: 90%; padding: 22rpx 28rpx; border-color: #f1d6ae; border-radius: 28rpx; background: var(--amber-soft); }
.message.urgent .message-bubble { border-color: #d7ab86; background: var(--danger-soft); }
.evidence-link { display: flex; align-items: center; gap: 14rpx; width: auto; margin: 24rpx 0 0; padding: 0; background: transparent; color: var(--muted); font-size: 28rpx; line-height: 1.6; text-align: left; }
.evidence-link image { width: 24rpx; height: 24rpx; }
.answer-sections { margin-top: 20rpx; padding-top: 8rpx; border-top: 1rpx solid var(--track); }
.answer-sections view { margin-top: 18rpx; }
.answer-sections text { display: block; font-size: 30rpx; line-height: 1.7; }
.answer-sections text:first-child { margin-bottom: 4rpx; color: var(--amber-deep); font-size: 27rpx; }
.answer-sections text:last-child { color: var(--muted); }
.plan-action { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; margin-top: 24rpx; padding: 18rpx; border: 1rpx solid var(--border); border-radius: 20rpx; color: var(--amber-deep); font-size: 29rpx; }
.plan-action button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 8rpx; min-height: 64rpx; margin: 0; padding: 12rpx 20rpx; border-radius: 999rpx; background: var(--amber); color: var(--on-amber); font-size: 28rpx; line-height: 1.4; }
.plan-action image { width: 24rpx; height: 24rpx; transform: rotate(90deg); }
.message-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }
.message-actions button { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin: 0; padding: 0; background: transparent; }
.message-actions image { width: 29rpx; height: 29rpx; }
.share-product { display: flex; align-items: center; justify-content: center; width: auto; gap: 12rpx; margin: 18rpx 0; padding: 14rpx; background: transparent; color: var(--muted); font-size: 25rpx; }
.share-product image { width: 29rpx; height: 29rpx; }
.context-details,.memory-review,.readonly-notice { margin: 18rpx 0; padding: 20rpx 24rpx; border: 1rpx solid var(--border); border-radius: 20rpx; color: var(--muted); font-size: 27rpx; line-height: 1.7; }
.source-caption { display: block; color: var(--muted); font-size: 25rpx; line-height: 1.7; }
.memory-text { display: block; margin-top: 16rpx; white-space: pre-wrap; overflow-wrap: break-word; }
.readonly-notice button { margin: 12rpx 0 0; padding: 0; background: transparent; color: var(--amber-deep); font-size: 28rpx; }
.carried-memory,.memory-fold,.save-state { display: flex; align-items: center; justify-content: center; gap: 12rpx; color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.carried-memory { justify-content: flex-start; margin-top: 24rpx; }
.carried-memory image,.memory-fold image,.save-state image { width: 29rpx; height: 29rpx; }
.memory-fold { width: 100%; margin: 22rpx 0; padding: 18rpx; border-radius: 18rpx; background: var(--track); text-align: left; }
.save-state { margin: 28rpx 0 12rpx; }
.answering { display: flex; align-items: center; gap: 14rpx; margin: 24rpx 0; color: var(--muted); font-size: 28rpx; }
.answering image { width: 32rpx; height: 32rpx; }
.latest-context { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; width: 100%; margin: 24rpx 0; padding: 24rpx; border: 1rpx solid var(--border); border-radius: 24rpx; background: var(--paper); color: var(--amber-deep); font-size: 30rpx; line-height: 1.6; text-align: left; }
.latest-context image { width: 25rpx; height: 25rpx; }
.context-limit-card,.inline-error,.state-card { padding: 28rpx; border: 1rpx solid #e9dcc7; border-radius: 28rpx; background: var(--paper); }
.context-limit-card,.inline-error { margin-top: 24rpx; }
.state-card { margin: 34rpx; color: var(--muted); font-size: 30rpx; line-height: 1.7; }
.state-card text,.inline-error text,.context-limit-card text { display: block; font-size: 29rpx; line-height: 1.7; color: var(--muted); }
.state-card .state-title,.inline-error text:first-child,.context-limit-card text:first-child { margin-bottom: 8rpx; font-size: 33rpx; color: var(--ink); }
.state-card button,.inline-error button,.context-limit-card button { width: 100%; margin-top: 20rpx; }
.inline-error button,.context-limit-card button { min-height: 92rpx; border-radius: 999rpx; background: var(--amber); color: var(--on-amber); font-size: 30rpx; line-height: 92rpx; }
.chat-end { height: 28rpx; }
.composer-area { flex-shrink: 0; padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--ivory); }
.composer-area.keyboard-open { padding-bottom: 18rpx; }
.composer { display: flex; align-items: flex-end; gap: 18rpx; min-height: 116rpx; padding: 22rpx 20rpx 22rpx 30rpx; border: 1rpx solid var(--border); border-radius: 36rpx; background: var(--paper); }
.composer textarea { display: block; flex: 1; width: 0; min-height: 52rpx; max-height: 208rpx; padding: 8rpx 0; color: var(--ink); font-size: 34rpx; line-height: 52rpx; box-sizing: border-box; }
.send-button { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; min-height: 84rpx; margin: 0; padding: 0; border-radius: 50%; background: var(--amber); }
.send-button image { width: 34rpx; height: 34rpx; }
.chat-page .composer .send-button[disabled] { background-color: var(--border); opacity: .65; }
.chat-boundary { display: block; margin-top: 22rpx; text-align: center; color: #9a8e7f; font-size: 25rpx; line-height: 1.5; }

.context-source text { flex: 1; }
.context-source button { flex-shrink: 0; margin: 0; padding: 10rpx 0 10rpx 14rpx; background: transparent; color: var(--amber-deep); font-size: 24rpx; }
