page {
  --ivory: #f7f2e9;
  --paper: #fffdf8;
  --ink: #28231d;
  --muted: #6f6558;
  --brown: #28231d;
  --amber: #f9c747;
  --amber-edge: #876611;
  --on-amber: #28231d;
  --amber-deep: #654617;
  --amber-soft: #fbe9b6;
  --border: #eae2d5;
  --chart-secondary: #f6da7f;
  --track: #f2ede5;
  --success: #5c7044;
  --success-soft: #eaf0e2;
  --danger: #a13f31;
  --danger-soft: #f9eae4;
  --card-radius: 42rpx;
  --page-gutter: 32rpx;
  min-height: 100%;
  background: var(--ivory);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, slider, switch, image {
  box-sizing: border-box;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 32rpx var(--page-gutter) calc(48rpx + env(safe-area-inset-bottom));
}

.brand {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.page-title {
  margin-top: 18rpx;
  font-size: 56rpx;
  font-weight: 700;
}

.page-lead {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--card-radius);
  background: var(--paper);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: max(92rpx, 44px);
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.3;
}

.primary-button { background: var(--amber); color: var(--on-amber); }
.secondary-button { background: var(--paper); border: 1rpx solid var(--border); color: var(--ink); }
.danger-button { background: var(--danger-soft); color: var(--danger); }
button.primary-button[disabled], button.secondary-button[disabled], button.danger-button[disabled] { background: var(--track); color: var(--muted); }

.section-title {
  margin: 34rpx 4rpx 12rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--success);
}

.status-dot.offline { background: var(--muted); }
.status-dot.warning { background: var(--amber-edge); }

.safe-note {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-left: 5rpx solid var(--amber-edge);
  border-radius: 6rpx 20rpx 20rpx 6rpx;
  background: var(--amber-soft);
  color: var(--amber-deep);
  font-size: 24rpx;
  line-height: 1.65;
}

.chip-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: max(84rpx, 44px);
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 24rpx;
}
.chip.active { border-color: var(--amber-edge); background: var(--amber-soft); color: var(--amber-deep); }

.empty-state { padding: 90rpx 36rpx; color: var(--muted); text-align: center; font-size: 24rpx; line-height: 1.7; }

.product-visual { display: block; width: 640rpx; max-width: 100%; height: 380rpx; margin: 0 auto; }

.metric-heading { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.metric-symbol { display: flex; align-items: center; justify-content: center; flex: none; width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--amber-soft); }
.metric-symbol image { width: 23rpx; height: 23rpx; }
.metric-symbol.neutral { background: var(--track); }
.metric-symbol.response { background: var(--success-soft); }
