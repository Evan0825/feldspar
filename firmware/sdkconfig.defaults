# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# Flash 设置
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# ESP32-S3-WROOM-1 N8R8 / 嵌入式 PSRAM 8MB (Octal, AP_3v3) 必须启用 SPIRAM，
# 否则 BLE 控制器等访问 PSRAM 相关地址/时序假设失败，出现 "controller init failed"。
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 分区表：自定义
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 蓝牙：Bluedroid Host (GATT) + ESP32-S3 BLE 控制器。
# ESP-IDF 5.4 对 ESP32-S3 在 Bluedroid 下更稳定，NimBLE+Legacy VHCI 组合
# 容易在 nimble_port_init 时返回 ESP_ERR_INVALID_STATE (0x103)。
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_ACL_CONNECTIONS=4

# 预留 NimBLE 切回方式（若日后需要切 NimBLE 可反转 Bluedroid/NimBLE 开关）
# CONFIG_BT_NIMBLE_ENABLED 保持 n，避免与默认 VHCI transport 冲突
# CONFIG_BT_NIMBLE_LEGACY_VHCI_ENABLE 保持 n

# 编译优化
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# FreeRTOS 主时钟频率
CONFIG_FREERTOS_HZ=1000

# FATFS：外部 W25Q64 存音效文件需要长文件名（24 字符）+ UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_MAX_LFN=64

# 磨损均衡扇区 4KB（NOR Flash 擦除粒度）
CONFIG_WL_SECTOR_SIZE=4096

# ---- OTA 回滚（P0 必须）：使 bootloader 支持 PENDING_VERIFY → VALID/INVALID ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- 崩溃转储（P0）：panic 现场落盘到 coredump 分区，供回滚原因分析 ----
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
